        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Quartz Sieve cryptominer sample, as reported in campaign PTF-02387. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Quartz Sieve Cryptominer: Process started from known malicious binary (PTF-02387)",
        "note": "## Triage and analysis\n\n### Investigating Quartz Sieve Cryptominer: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Quartz Sieve cryptominer in campaign PTF-02387.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"9deddcfd8965308f2e74bb0231afb6d87f7413ef50780574062a20123feb4c9e\", \"32de2a2dbc6955bcfa0f26bc78c98e7bf6ddad4b15a68cf9d889ec2389db48f9\", \"a5aa1419303de9ece73301d45618c861b545b38cb4a229e124691d2b978c2d9a\", \"63c5fd5c7f66417be552474b91413a58ff44ef55699bd8f2fe3787f7e92d9add\", \"41551a36d1432e2371aebe3ca24ec7df9f2d8d821ea9609f16061e91d483b71c\", \"d347fa84b12ee91d6225caea9c94cc499d8d8354a458bceff151a052732b3de7\", \"794a0970365c2db203c0b1744b6ce7455acdb5de2fe9db0524f098ff76640a77\", \"bca8db797b073d92b8077db9919547319e5a9cfe341c3b90f35713403496e27c\", \"583c4c1a6e8a357f4a4cb97b567ac21350ee2486be6a9da7aa25e9855e828e80\")",
