        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Quartz Sieve cryptominer sample, as reported in campaign PTF-02389. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Quartz Sieve Cryptominer: Process started from known malicious binary (PTF-02389)",
        "note": "## Triage and analysis\n\n### Investigating Quartz Sieve Cryptominer: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Quartz Sieve cryptominer in campaign PTF-02389.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"916c312673d0f69dfd1073182786e77b5a1c8b27852fc1eeb30efbad107c8063\", \"98fbe16f9bd9c2e593aafc40c458b4768b6d9195a5f83aab7532fdda6ba34889\", \"650644fd25975ec2ccb327d52b1c7754fd9cc37e9034a636d567dbea21dc4b9e\", \"e86fadb7ff9baee4d11f5b7574217c43044d315d5b21633863bfba4d4a355fba\", \"fe69888198124db2629044bda8daf71b01932da747f2c0f209eb3050cbef8331\", \"23c0c2e0242698ee453a147614771c6c4244cf9e4af3467f6da4475891cda1e3\", \"b3f09352d67c773a314ef71e8adea306866d056b1ec29fc1d6744d92f3e1d892\", \"a5786642b4b7f6f82709db210d108548a0783abde422743a3be37a4bdf5263b6\", \"695f27fca91a11154eaff9de69915ea47d58ef9ead4dd2acd9efb582f26e9d71\")",
