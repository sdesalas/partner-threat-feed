    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Frosted Satchel cryptominer sample, as reported in campaign PTF-02345. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Frosted Satchel Cryptominer: Process started from known malicious binary (PTF-02345)",
        "note": "## Triage and analysis\n\n### Investigating Frosted Satchel Cryptominer: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Frosted Satchel cryptominer in campaign PTF-02345.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"ce35a497ce7dff2dae395ef591b672688e3dd53a8e49595358e706f03bf3fc1c\", \"3a90fb111bf7b3f6d532f49bfb00d391275ab9ec352360af8be65751f60fb891\", \"a106ba09101bc1e5440fa01f4fcd8c70e7b8ff30944a8d5f2cf54cc8e5a7c038\", \"04665606d58cc9ab5ba63b614eb5eaa3f8897d6edb35cc2f6003139fe1069de6\", \"9054171a7f4e7e99b5f1c4eacc6d94f4b022b0aaf7c42c25fd9be749b30aeadf\", \"f1b6a28883d414a0a43fd05c4d9070fbb2a37c45a6f4b837932e363b937bc121\", \"3366371325dface5870bc2547e2402190fc2426ef1cb947368ca2b6869e23113\", \"a699e3b9503b5ee2dddf1a6a4cf876d7661a754d29a857c5c6d099e140375c62\", \"0336907b293c1894224384203d115f69664a1dda39eabdd11a97b305974f4486\", \"26a71839fa420c693cb8adc75e3ae147b5c3cf2f5588e6f58192490f921f5cab\", \"733c423d80a477f7d00adeeb3dd03e7c0cce2831f762c631dc9db906bad7a6ee\")",
