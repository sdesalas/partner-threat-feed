        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Hazel Shuttle cryptominer sample, as reported in campaign PTF-01504. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Hazel Shuttle Cryptominer: Process started from known malicious binary (PTF-01504)",
        "note": "## Triage and analysis\n\n### Investigating Hazel Shuttle Cryptominer: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Hazel Shuttle cryptominer in campaign PTF-01504.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"dd139e6d9ac6857bb78a501a8a0c8326ee81cf282293879858105ffbc4c66f61\", \"9d123ff15c353d9f6e5335dacd9f5c212852abcc4d76f909bf69fd039b782190\", \"dba6faf13b0672370069228092bf489eeefb825d1f869b6805e8ca371e07c191\", \"2d440e748b34f121d77575366a594107a4bd57093427ef78d1aac6867a814e25\", \"ce2c70d05cbafe94f9fe3b15d508d9f068ccc7988138ca645b046f13c35df3f8\", \"1fc5b90353731dc5109e1f94640f0f924a74972b5353c0b7ddab9cbb6f939761\", \"3034c6ba6ac56e663c54a2f3fbe94ec398beb55e516a79f89f7d593d3bffe094\", \"caf7b15613d53aea7e766cfdbbde27885aea64d2f3c362b18cd18e2ec99a72d3\", \"7c22c56cea7377b3bea6fc3379bfef06b997718f99277318dbebc94281a121c6\")",
