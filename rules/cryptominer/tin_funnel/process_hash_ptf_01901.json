        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Tin Funnel cryptominer sample, as reported in campaign PTF-01901. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Tin Funnel Cryptominer: Process started from known malicious binary (PTF-01901)",
        "note": "## Triage and analysis\n\n### Investigating Tin Funnel Cryptominer: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Tin Funnel cryptominer in campaign PTF-01901.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"d276f9649bcbb4e9eef42701bc3fff26203508ab725952cfca0b324a48326091\", \"0ad4f63a079b940dd7a83dc678086e8a1d2978da1951f42b5006a7a71ce12a63\", \"67a06d52027ef8a907b5f42c5e4565d239538519edc5a63c54560762c16b8bec\", \"49bbc91efb4840b95e38a72f0354a6ec7ffe474d8f47a1711a1b43cb307f9241\", \"4aa9986ea32914dab643fcbbec9ef55e0290a8a7cba2902b5f7ae4fca79a528d\", \"958dc7f7e094e1e7f4c51a57fdd9066b40050263912a6f7f629a6f9385f69133\", \"968e203699e0c966856863040b1ea52d2a14c901733ef7603a47ff62f2513d56\", \"f7acf01d22bfb1ee37597ef2404acf79eecb9985e4237d473f7ce4ef0ecfd369\", \"35a9901e37ad59a7290ec442a1c3580482390891220e6a44c86a002b4dfe92ec\", \"ebac4509b1432f2af2ab8a1f51cb7bae29847ad3e74f72db6893f311160f152f\")",
