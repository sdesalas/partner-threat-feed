    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Frosted Ladle cryptominer sample, as reported in campaign PTF-02428. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Frosted Ladle Cryptominer: Process started from known malicious binary (PTF-02428)",
        "note": "## Triage and analysis\n\n### Investigating Frosted Ladle Cryptominer: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Frosted Ladle cryptominer in campaign PTF-02428.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"759fc8273744a8df761ab22e9edc2756553642bb582295a7453f5e0d8d2ac8b6\", \"0091d29e2ca961003bbe6167d3df3ce49469ea82227bdfb06db1b40952b03331\", \"eccbd48754ed823da1df08aa11277bbeb96cc44593224f756d1098a1d1aaabf6\", \"a0a4348868ca9c80c47f948975007e291c07f94e48fd91016c78d0d2e22bd72c\", \"9fa321a5a5fb0c9cd8b42b189d04ea3f97234fb6f612a081f6d5747260a45dda\", \"b1fe6dcc956d99dcfebf657181c8ad8436c16541901a765ed75c1bfd37c2903b\", \"1a03dd58d815570570b457bf890cf2461d5273e2eddd2b3003677e942fb4ba09\", \"42f3b0c9f22310831ef8d7c17726f536c9d3dd06dca79317871aba6465e95088\", \"16df196bd4bfed0eab613d54bca1ce1a0ee5d7301fe52a670bb770c34ab7dfd4\", \"195e58e19502513177b5e30ccd31e311d252ae8c848971c7f651ed96af7b6eb9\", \"2aea1b86fb4f6180b8d7bb2b10c498fbf2ae752b0734d70457f8bbf0c3ff7c0a\")",
