    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Marble Mortar cryptominer sample, as reported in campaign PTF-01577. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Marble Mortar Cryptominer: Process started from known malicious binary (PTF-01577)",
        "note": "## Triage and analysis\n\n### Investigating Marble Mortar Cryptominer: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Marble Mortar cryptominer in campaign PTF-01577.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"d8ab25e570163c05b01039acf05c78db5eda5b416643d9ec5abd906d3bf2f3e3\", \"39f922c9ab6c41a5835446067319c1fc683180f0658791996a53f6ac6591cd49\", \"71b2bf648e7bf32552935294a11a6dadd6e627fddaac683d24971d61cfadde37\", \"2645394cf9006c15b7743aa2cdb417e871d6abf2ab6b3fd79810d037bb972cd3\", \"058238183ccc40d4414598d40d5b3510894a232fb0e2c7270d2559d65d054d5f\", \"27ec2bc3da9970377f0d094365603b5ac51ba2617c4ffdab0d6c025d1685bfe4\", \"9cd04f75abd8538a92be4934e9bfc1d478e745687b5aecbec2b6c43a165f0398\", \"3be4edffc41b16dd69402245b8f055b12343c2c9472fb5e70a78a9d015873c6e\", \"54cac03e3395cd5e1ab72dc102023e40a352257846e54670c42d3e2349a56109\")",
