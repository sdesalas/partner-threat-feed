        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Driftwood Jigsaw cryptominer sample, as reported in campaign PTF-02462. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Driftwood Jigsaw Cryptominer: Process started from known malicious binary (PTF-02462)",
        "note": "## Triage and analysis\n\n### Investigating Driftwood Jigsaw Cryptominer: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Driftwood Jigsaw cryptominer in campaign PTF-02462.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"b87d91647ae2bd3473ecd8616f7a356162b0dacd0cd0ee70c0a0d1163c8c0a7e\", \"64fe1e4000208e2f3213bbb7c68231f00705f89ffb68c70c81e14a637b8c31d3\", \"60dde72e9319191bfc0c4f451db84f0ac48d463ed579239969f52e8d418c957f\", \"fcfcd37101010f5cf8fab105110a8a929b736e206870f207d90790890d8d2bea\", \"30457e856ded7811f3a23cc954d27f19a05a4a365208d2d62d633172a4f80962\", \"f6df958ba370ec0596f2578db20e9230ee462051c2a18944452827240ff35ef1\", \"32dd92cf6e86bade537d05e4ef8f006ea39bf8ab993a703de011de1c2c051c38\", \"1429715e2a3d7315024468f7e520fb9ddfb25a52d80c16d4c2d4ab77b66f2c6a\", \"f0d2db3904f651c66046cc4f4cef1abba13663decdf0ec4896e24564e7f96be2\")",
