        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Ivory Bellows cryptominer sample, as reported in campaign PTF-01536. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Ivory Bellows Cryptominer: Process started from known malicious binary (PTF-01536)",
        "note": "## Triage and analysis\n\n### Investigating Ivory Bellows Cryptominer: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Ivory Bellows cryptominer in campaign PTF-01536.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"88fa82901b9ca85424c3c12575f494613944ef5b4accd91d9759566c280299f0\", \"fe85fec899881619a2bb042044a506d3d58ebbea7d3d0da8267d3d2ab7463a0a\", \"b96ac157f06b92d933efc6530bcab0505a127a01b27d4fdf29d6463d67afa653\", \"f1ac89fdd9b24202f6bacdbc8930415f9cfcc407316399bc2a704c1a78c536c4\", \"91eadb3bbf28d5e17dbab11102aad2c4b51fbe5bf90e018743c05ea55162caa1\", \"a8c72e5a74793ca3c3283f3d8001b3098db60f80a8d95e4ef9a04355478c4db6\", \"69359f2e938bc92ffa22ea3ead58d3042d765b94e50a3ce8678a99b66c687ec2\", \"3db9c3d33032bf0b6efd4cf06194fa516d0a679293639b8d8cbe93929622e62a\", \"dd3600c7de3e38840bdb58792a1783c0c8ac86b5adcb75caa03320f89b430694\", \"961d4c9401f00057bf8fcd9d8031522d632b6befdca18177d2505c34fd359b63\")",
