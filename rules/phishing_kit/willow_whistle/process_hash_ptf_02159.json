        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Willow Whistle phishing kit sample, as reported in campaign PTF-02159. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Willow Whistle Phishing Kit: Process started from known malicious binary (PTF-02159)",
        "note": "## Triage and analysis\n\n### Investigating Willow Whistle Phishing Kit: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Willow Whistle phishing kit in campaign PTF-02159.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"4fd2bbe1e4d0934bf530e3721ac34f98b491e3ef6507cce41f25ab26345c7932\", \"91cdf30c839d025eaa4731cade039042e227a1bf46b21ec6092e84b4704216e2\", \"b918bce0cfcaa619b0ed58dc50ea8d900815b09615aa8bcc21c374207f54bfb9\", \"825b84ebad8b4449e8939248186c1273d22291a5870e6dc9fe6c984a00478112\", \"7703ffb2700ef875297bd19f8aa16e3df730b6584fe9b9786ad36c9d0a224143\", \"544af07e511f1cfb2bc48a84e5a24c0e7b1c2a1982d1cad79edc73793d39aef8\", \"db0367f327f45aec0ab1cd676ed025ae90575b8e1a5fb726755480ee3ce62e42\", \"c1e48817ea91af948424d55ddaf368567ec2a20623241bff8220a08907d7985b\", \"b8a14b02fc87c103191dc35a0d3305fa0fc0bc99692186c99a38dec9c2b84251\", \"ea92c09c5d1439e2534f02cbd5f37daa8f3edf1b94f63910236f5c5ccff76c9b\", \"b3ed0c8cdf90126b5c0e25258287c50b476383538fefbc3ac9c03faf096eaf8f\")",
