        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Lacquer Teapot phishing kit sample, as reported in campaign PTF-01835. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Lacquer Teapot Phishing Kit: Process started from known malicious binary (PTF-01835)",
        "note": "## Triage and analysis\n\n### Investigating Lacquer Teapot Phishing Kit: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Lacquer Teapot phishing kit in campaign PTF-01835.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"cf424006b48200ae58b8f4c13d65683d95982f86e5092c61c2548ff939ecf0ab\", \"b7c07ebf6bb73bdaa0ac9b609b19a6167023c820004f3976091db71868c9dcc2\", \"244d8e34add06a09d279d8ae360c407d3517dd3ece6273f2b25a1c9a5d182427\", \"beb3113d19ed167eaaced6d13b4b949cc498c02387fb32668ffec46981da1b45\", \"f7b7f0bd7209a56549f34be36d1befbd453e1c4ae0118b98228e34c7147a8f7e\", \"d6d594e5d299dcd09cdaa07874b035c68fdbbcce81492aa00c253fd162ae5a84\", \"33cf7050970479647cd05597df3640aa203909b22183bb6bdb9873acdbcec220\", \"fefba347b7135e2d3dec6c7c2a586017bd03302d0fa25a867a7e3437e4f4dbc6\", \"4359e1894181b87907c6e04787d26dd26c8f33b89a116cd209ad0660a0ca0b5d\", \"734247e224c31be901a270853230b4b2b0b3c646f9cf82627a270d8fbd70c308\")",
