        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Slate Sextant phishing kit sample, as reported in campaign PTF-01537. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Slate Sextant Phishing Kit: Process started from known malicious binary (PTF-01537)",
        "note": "## Triage and analysis\n\n### Investigating Slate Sextant Phishing Kit: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Slate Sextant phishing kit in campaign PTF-01537.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"60392e3b3e45929e8bc882857d4672ce8b5ef7a9c7bd70790e7f00d9dbc784de\", \"ef90491db5b189e7ec43510583a5c6d4bd3b27a5b1736fbf78346874de9387fc\", \"6a7430fb493e3d9c08fca18386bf02165d3db60c283947f665fd21ce73ea8aab\", \"16ced368e09843c89acd278e2520e00c02951bd9324ab821ecfd5fb7e3a3a802\", \"3e1b25da07a4da746c14c0c7d82b4d9ff3769fd18d5f49be9b54d3d6e85978b2\", \"92e60c36de1f2a37a3098d0d8379eb42f840ee8696fdcc5b67267f510f07fd6c\", \"ecd9ce365a5352645ba056b2e4e71d8763c8a6ac542b2a68986f1ddf6c130bf5\", \"9e1cedad31859534ec83f65bc2faf65dfa854e953630150004b5142a06e2184f\", \"bf06c14bce6a52bfd325fcd098d11ee8e549c641e8634f7f40562c84fa166e35\", \"75630d641775ab6a7875b337abdf7f244f87a64f35bcb5f925d647fd6844b433\")",
