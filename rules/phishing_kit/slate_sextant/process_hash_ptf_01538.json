    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Slate Sextant phishing kit sample, as reported in campaign PTF-01538. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Slate Sextant Phishing Kit: Process started from known malicious binary (PTF-01538)",
        "note": "## Triage and analysis\n\n### Investigating Slate Sextant Phishing Kit: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Slate Sextant phishing kit in campaign PTF-01538.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"d7a8791762aed500c6a39b8e12db4784e7fbfef081bce774df6ba979c834b123\", \"6db37e30a8a1790bd808ee382ae364c3d674fac9fbfb918da9955a489609f29b\", \"d798c90467f6139e24fb8e284f6bb4fffaea9ff0b6b371f223526e3bf01c6a1e\", \"a2ae706c4f23459047069dd8a45c05934e57cbeec8c7b6b27e78363365c0fc77\", \"862f9598986e7c6e597bdc449c8b5c4ce5a5710d0e74b2ff299de7838fc4b08d\", \"364be0d2b010da9d01c8c8dfe029a3f78a5b6975bc62b13b28ebc4792703f3e8\", \"08f2d70b915a934c4f342de2999c666d921531b6b94fa0b5cb8302be73b35a2b\", \"5f602d956c6a44ad5bf30ba06e661c3c965d0cb5d19f9a690784295753be7fc7\", \"f1d0c197a06b3603b8862b7f2edbf70e2cdcf9336c54354990ec8280143776b8\", \"a54fe1d2b38ae731c5c7fff4d7c667f098510fe0ce9e684842f3a07c23b482e5\")",
