        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Gilded Ratchet infostealer sample, as reported in campaign PTF-01628. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Gilded Ratchet Infostealer: Process started from known malicious binary (PTF-01628)",
        "note": "## Triage and analysis\n\n### Investigating Gilded Ratchet Infostealer: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Gilded Ratchet infostealer in campaign PTF-01628.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"eedf479c826d31337e36b62a01cfbad659ee51c94c459e9634875aaf9e9b459c\", \"753d1d0e2e8bf116d14c1267b88791a47b1693ca5195cf3d334f3abbd7f04f42\", \"2c05b6dbcc9203ed436628c0e8b7d6ba2732539d7981b92b6c754b7e7f020941\", \"b675947e0762216c153eea9ac6f8f391f7956333dc9982d2dfbabac36f1cd4a7\", \"0aedf316f73c39b0c2bf79a7d641301aae672b28840f1dbc74a1c0fbb65299fe\", \"da5369aa8f5bca7db85dac1f2479fa72cd10078fe1844e08a7247f4f448651b3\", \"4ed76c988137464b0f74fdf0805b259f225d1492556d86a787cbe67b1e285ea5\", \"7be8ee780338c223c0e99862a795a5a0cbdd492db710c07c8db7abaff0c09f4d\", \"0841bb794cecf5d60ced8aa3cdb1ab49bc908cace148a98e717326ba7f872281\", \"e023dbee007b4762663e8e82b2695966c9c854af0f79dc749cd151dbc2b81389\")",
