        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Gilded Ratchet infostealer sample, as reported in campaign PTF-01626. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Gilded Ratchet Infostealer: Process started from known malicious binary (PTF-01626)",
        "note": "## Triage and analysis\n\n### Investigating Gilded Ratchet Infostealer: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Gilded Ratchet infostealer in campaign PTF-01626.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"a648b55acf1e7d2b904cd41ef429137e40e17c4b4aabae7c2e9ded795d25f68f\", \"0b86030df301eeb0f7c46109662c971a8be41a3821ff8ef9e07344b86269f3e6\", \"60c1410e0e3d711be810aad62b37b447557b86faa46552f0c17f04c9e34f9e33\", \"333acd471268634687093533126698e81e7d274aaadacbf559cd4b098691db5b\", \"ce6fcf657533ef3d23809075feadbf46ce33a3d70428395ea9b13fb5c2a6eff3\", \"2c5d06fd420a62600917a0c0545b397544bd18ab86ec4c51e732bee4e5ab713c\", \"32077f83454da507b95bb1c87d95b203345acadc29220568511a22be035ac532\", \"6aae83e7c8658d22fa70f5ee9ac204f67430a5e2f44ab909328001abb86de8d6\", \"347a2c0a4bf161a03fd4bb1ae105700be9ee69641a5316171d6d79bde2d25fc4\", \"dd086fdbede8ef7a5d85b148d2d17ce1ef10195fc400ec89b75bbd9fb23fd7af\")",
