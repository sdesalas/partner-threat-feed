    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Tin Mallet infostealer sample, as reported in campaign PTF-04140. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Tin Mallet Infostealer: Process started from known malicious binary (PTF-04140)",
        "note": "## Triage and analysis\n\n### Investigating Tin Mallet Infostealer: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Tin Mallet infostealer in campaign PTF-04140.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"7693234852967dc12a2619c517d4d540ec21752276edb8c085a28a57993f15bb\", \"d246dd6739e6b58f4889b276c1d25e11d8b1abffd03f56836f70a4ac89758e0c\", \"5d998ee82393bd238a0b1058dc92111f79d2dac404aed9fc1cf495b77221c005\", \"5381383c1b98b29fe5ff6e9497eb5a153f07e96c1e530067010ff7834e4f7ace\", \"3566ca9274ef913571751629bbc3a023346da2925a0dd35651ecf0190c2d1a75\", \"7a01fdb6ed03c62db1350d652cf94bed77405814bf11740af208aceaa64a9a4f\", \"6512df7fc8d4f63b915ccc2b33c0b3217273801f165e339d9da92e3ad2f317a8\", \"68a48e22ee129e0ec00acce34781e73fc13212df27942677f092053d3a3aeda5\")",
