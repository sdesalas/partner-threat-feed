        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Ember Satchel infostealer sample, as reported in campaign PTF-01785. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Ember Satchel Infostealer: Process started from known malicious binary (PTF-01785)",
        "note": "## Triage and analysis\n\n### Investigating Ember Satchel Infostealer: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Ember Satchel infostealer in campaign PTF-01785.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"0ef2218ca9e564cb97925baadb68ede859a8fd0d1184fb28e208d1b98ccfe4ae\", \"9745970024d238d37945832691b9a8c64c66af8806914cf4d7c6279f376deba0\", \"b30d04c559e90b0a8212ba55f8024ad7157e098e30b0a4c54431f108677bfd62\", \"f227b626cb27e592ef464e65f294f83637bae36c3e98c298a7902724bd75917b\", \"3f62a5a5382818758f7c36f929d40a651a00ae3ed71b4d6c692d1ba69510ca71\", \"9587c1f8db9e2a3a5971f7316848689821a67a89ebe28bc797e19e5bee95f056\", \"5ed9a25a01dfef353d2244f5063160a5e455ed81a914364b5ee22622ccbfa23b\", \"a6c15ed78290b2ac7ca1ba6eee6b721fc10519fea3b8ba7c0adc402ef467cbcc\", \"6dac2532a444a5553299c7de4a56de4d5eb751088879e011015ca6922e8a84c2\")",
