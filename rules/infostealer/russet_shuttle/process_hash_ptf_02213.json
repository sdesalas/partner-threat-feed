    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Russet Shuttle infostealer sample, as reported in campaign PTF-02213. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Russet Shuttle Infostealer: Process started from known malicious binary (PTF-02213)",
        "note": "## Triage and analysis\n\n### Investigating Russet Shuttle Infostealer: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Russet Shuttle infostealer in campaign PTF-02213.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"b9bae2de71051825cb0fa5b73d4b1642ce41d144888832f30232dde0ce9f89ad\", \"ca268b19612b55258a5f92813b9863e675496f30c2b5fb487e2f3219cb20719a\", \"2d057674d6576198bc4673ca75131490e75f5ce3f3f1811457c02e2c810c6c83\", \"9e0d7e8f80c4e4ec85b2ad837c019700b9cc1970e2ac7c36f620634c9c211b11\", \"b9ad3b9108ac441c4ff2d87b43550e22ca080c044b15b5a08f9b89041cf5ec93\", \"e54da3de315a04d1e35b444a9516d02edf1437e6200199e3adfd205b65d79381\", \"6d05e3ca68d0811fe7c2799d20924e6ce5641071354bac0544d2b5dc1c23000f\", \"6e5bd9c0ed796345f7882f1e1af5c525c0e48a8648c0252d47489a4196eaa855\", \"7b9250543d35ecab9337a4c31862bb742c6a40e4aac7312bf5d9471e384d445f\", \"9263e5637f7429bd8d3e0e95a5f8718c9a5a5a32666fded941490bd1da4a1a52\")",
