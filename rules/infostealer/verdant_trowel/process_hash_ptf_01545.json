        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Verdant Trowel infostealer sample, as reported in campaign PTF-01545. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Verdant Trowel Infostealer: Process started from known malicious binary (PTF-01545)",
        "note": "## Triage and analysis\n\n### Investigating Verdant Trowel Infostealer: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Verdant Trowel infostealer in campaign PTF-01545.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"8e0f5343f6973ce0ba0c2b2c150c2ef8c3d64944a62ab87723ab6d46584da1f5\", \"9661acc58426f3637dc49d4a2a25dfc5a475b0e78bb54d0065c0dd031b3db59a\", \"9721d7e9b6c624c08c523a3f4f4dc0ee07903c207d7a509d28f6eb0e0693e4eb\", \"9c33016f56743234b4e0d57418675fa25ce825fd3b5de4239a13610b739a2c9a\", \"83f1709bd58c37acbaa70971d4d0209281c727918da8d1b2ba9edc54d84e8c8e\", \"84698ba698aba1026dff2d67a66aaea9b5a6812e38d30fd16929e2b3e50559d8\", \"051bb91e45e2ce0ff120d5aadfb4750c58f7e9ca3bbc6518952f3b7d155c2128\", \"07938bab5f4c862aaad22182c265d9f892e15aeb4ceef286021c03f81dda955a\", \"eb5a41cc7eb3bb02cefbc3a416873e888f735e13f890ec547926252a1fffec8d\", \"a31b975b59fdd32c760f6ba1e86f4b942611ffd655373bb15eb1dc00dae0f98b\", \"f218849009b80c518620618b8509908e771e2f2f8cd2b83c74529475176c6050\")",
