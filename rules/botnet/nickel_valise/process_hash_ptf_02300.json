    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Nickel Valise botnet sample, as reported in campaign PTF-02300. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Nickel Valise Botnet: Process started from known malicious binary (PTF-02300)",
        "note": "## Triage and analysis\n\n### Investigating Nickel Valise Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Nickel Valise botnet in campaign PTF-02300.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"a9996be4f9e5790149d138b3a36bbab9642afdbbecef9fde6047ae23de9f0216\", \"4ec349c950a13a6472c5dc3120daa817e0e928967d51aeacfb01220e0bd114b6\", \"6e967b121d9dec392855f6ba2c2979145dd5713619fa46536b7b74ade10e9a3a\", \"2f167f4933013fa34579ff5bc71edebcc6ffcdc32d9db506787e5a5e7c7f3108\", \"e7f8ed615e739b41479ab94b69a06b70edebb36db08d8260b75dd534f0c6c0fe\", \"503e7850de39bc28cb61b9926ed1d3e00b28d818528653c9930867001c657d1b\", \"93a48af9132c1fbd3a3c61c86886bcc91199ac94996a32bf3bc2ce5a2f64786a\", \"1a45be3f562f050fe3cf74144445487a419c6594779c430c063b664579b82d87\", \"6c63237d17c6e1decefb15de543ed2b1124ebc84413934ce489f8fb6fe403c29\")",
