        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Juniper Anvil botnet sample, as reported in campaign PTF-01683. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Juniper Anvil Botnet: Process started from known malicious binary (PTF-01683)",
        "note": "## Triage and analysis\n\n### Investigating Juniper Anvil Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Juniper Anvil botnet in campaign PTF-01683.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"98fa4f1160e4e3adaa08cd7adcebb703b9868eba8207e343f58684b378022967\", \"c315dd2e13e0725533490f692cbb4b8253fb9b90c514ba2324059dd5088b0da3\", \"b08499f9d40831ffedd222dd1aaf591fb544f264e6552a5c9be97f53e1867e1c\", \"a3544bfe711fcea79c002b79ade3336e25abcf299341f9c113314a84826d15b9\", \"2761da8c103bef7c1f1e04ed219d38ca7de30c3c2bf6dbed98e99d02705c2850\", \"06c1699b444b22d54ff4572b575c3637e68ee19fd64619495121006009cc9e2b\", \"9095e7c280b30991afbe22bf69d1290a40a11bcad6a75645a0a3706ceb040e9f\", \"f0ba68528ca693b8f50322aefba90b08cc013e5bd4c4fad4f853ed44fe9443d1\", \"1b3aaa1e86c78e5f34f8b6c5be21ca97a51796fe253b0e8ecbf3a51b3ae99394\")",
