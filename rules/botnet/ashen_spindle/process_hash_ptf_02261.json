        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Ashen Spindle botnet sample, as reported in campaign PTF-02261. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Ashen Spindle Botnet: Process started from known malicious binary (PTF-02261)",
        "note": "## Triage and analysis\n\n### Investigating Ashen Spindle Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Ashen Spindle botnet in campaign PTF-02261.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"718ba5f7811d92e26a943d0ad9c87477647060fcb6ed9f0949871daab2a5870e\", \"31e8fffd17287297113f1fcf382542512929867075534f450ca0741bcea6a796\", \"6f5427cbd828ceb129050776225184807410845ade8f7222f3a3fd1c46bfcb92\", \"b9081ee43f923e66b0cf7d2d7ad4f4a91f3ef0602458a81d56ba24c82bdf1a9a\", \"208472731aa25c80c4cfae1cfd9005205834996297aa6150085eeb4f1c52ab1b\", \"7323654d1789e79429e93db84a9d6f401c8c47e0b7fb0d32699b5bdae784e6d5\", \"7d935cefa613c948548aea159613b5645c6fd078a9900d730f119042e721dd9c\", \"5139a5a362dffa9816f6d56935267f3fd9405351f2c3ea1678f912a852e92fa6\")",
