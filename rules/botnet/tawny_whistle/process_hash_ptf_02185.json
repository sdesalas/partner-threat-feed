        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Tawny Whistle botnet sample, as reported in campaign PTF-02185. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Tawny Whistle Botnet: Process started from known malicious binary (PTF-02185)",
        "note": "## Triage and analysis\n\n### Investigating Tawny Whistle Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Tawny Whistle botnet in campaign PTF-02185.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"e16029bf589974480208ed1ae30f389e137e5328d517cd3da8ad86c914fd5aad\", \"5cda25e4dcdbb286e2f3969f2db7467f120c63636c11b39cfd032e075ea5b4c1\", \"bc3f6ca0d66fe6898b3c9af4b127c02eab71dfefd5af51f90a2eb25003eb00ab\", \"38f99bcce623f6c7aea52c699c7c5621c08f59466d2218a4ced43b6bc04e97b2\", \"79c0b0946c77f4af3d1746f830fa2246747bdc228767381f6dd33a5926650265\", \"d508f894f3d7a1be814c251b17d1c941ace8ee17250e015c7332a5d585ac8fa2\", \"01a9e11a60c69d1a6091e6d1f036801d9946f4f329226b5433d930461076594c\", \"eb266f382a64fba145685bb5dfea9b50f1439aa105eed8892cbd78c5f1a7684b\", \"a359fbdb01e75ab67c654b6cb3acc3c3f86143484c32d01d3d0709cb946153ab\", \"4f193408626149a51102af1fdbd545c8138bb41238276bfa906b93d01cd7a760\", \"7c358fe26126db6667de33f30fbc9d9459bc94e5a694cea40ad3e6a4e49fd9e6\")",
