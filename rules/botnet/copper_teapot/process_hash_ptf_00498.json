        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Copper Teapot botnet sample, as reported in campaign PTF-00498. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Copper Teapot Botnet: Process started from known malicious binary (PTF-00498)",
        "note": "## Triage and analysis\n\n### Investigating Copper Teapot Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Copper Teapot botnet in campaign PTF-00498.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"968f958c8ffc26004805c289ecd4e8de072e923c29f7bc6ada011ea66cb46b32\", \"b7407f013e2148b48118af195670c925867c6aaccfd1662168fd787a2c964001\", \"b19cf09d12995d3a3091920946a4ee653a2050ea5a717c9cf267efea0460feb5\", \"014f7a21a94102f7b58928fe2bec92e5e6e247fa6090693fbf3cd8a7e893c25f\", \"a02a5d57d54f196bf4b108ce531a0a790ce125d442cd12a37e9ec49aa3652cdf\", \"f80a6b2476eccf56dee602b7e68a69fc2c600062b8879f7da3bfdaad9363ca0b\", \"07166c66d6370ca941d9af3894b81def3d4faa9f34eeb785ec886254402932e0\", \"91ec9ab0289f8a0b04351c12b6595319ab15d1bf37924b6aeb0d2149d8a6cea8\")",
