    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Oaken Gimlet botnet sample, as reported in campaign PTF-03949. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Oaken Gimlet Botnet: Process started from known malicious binary (PTF-03949)",
        "note": "## Triage and analysis\n\n### Investigating Oaken Gimlet Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Oaken Gimlet botnet in campaign PTF-03949.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"ebd8f77863674500a38c875a8b1fa52e548a6382340d79fef2b0cebb83a25ebd\", \"d288175dbde9406b6cdfda5f0b99319abe70d53df5ffa3d4e95369818eb4336a\", \"f4830707b51f5251e1cfd6b5829847d5fcf21d60962384c43e9717e1077182e9\", \"059d395555398d36705b93d26b00e5879e20039bb5a7ebb73041b8d05842e1fd\", \"a09d737398dcaf61d3e25002e691a0e3c91b272f44131c01b6233d9b2416923e\", \"a5e742f9ea751656ac2811138f4d24e5211ffd1a5dd70179d5e86308878b72ed\", \"7be1917c3ebfba168c6e1ec7a8d6490b98785be43582b6f86be73bca5e1bb2ad\", \"1a6398fccace90f6631e26ce4240818628a8d81f2394f03cb9112a8429903dd5\")",
