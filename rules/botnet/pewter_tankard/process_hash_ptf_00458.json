        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Pewter Tankard botnet sample, as reported in campaign PTF-00458. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Pewter Tankard Botnet: Process started from known malicious binary (PTF-00458)",
        "note": "## Triage and analysis\n\n### Investigating Pewter Tankard Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Pewter Tankard botnet in campaign PTF-00458.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"b2d24c1f06a54aca13127f242037e7a935b20f5f4ce5b9f34992bf530e28f9c5\", \"a927eb17efbc1ee97085d87870e64d7c41e91584473ba09938565473d297f814\", \"0b1f39a73827a11cbb97b6da027dcad67cb3e465209b27c7269abe4c6dace01b\", \"cbd1be92bbf44f9ee1cfb80e08d099f368e4d46273596f00f1f65168cc46c85d\", \"35339b819502b6d0d2161ccef476112eb4cbee12b02c1838567fe2ef821d72af\", \"926c68717343787811f271356ed1f51f5de8880bb4d632a5e0ff9256cf59e517\", \"27a844fb61a179bfbfb137eee20eb6d7b4611f57813f0fdaccdc49e3af44d2c3\", \"2bccc81293879c0862ee8c6dbe4db880dd4a385fa5979a299f015221cd114df2\")",
