        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Mossy Pulley botnet sample, as reported in campaign PTF-01756. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Mossy Pulley Botnet: Process started from known malicious binary (PTF-01756)",
        "note": "## Triage and analysis\n\n### Investigating Mossy Pulley Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Mossy Pulley botnet in campaign PTF-01756.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"9f65f127130251509a76056cc509080235d93c31d1497887fe24a7a153769efc\", \"7e84f562d051e66d149d389098405e491abef0c0a23bfea6873591f582a4226a\", \"306aeaf5e7ef36f4cb95dc1a942247bdc4e0d5a34d3e67afce852e5026922368\", \"3f035216d7abd835334d42f3b9409830f376f3cb2b3af702b8b9ab14feac2a3f\", \"ef23e498d0f7a5671eb0e6e4f21cbd0a21415cada6222a95520a39a43044f14d\", \"16ecab4d4e3d93b551a6f98c4c331738e60bf58885f8d61b6b37fc998f965cca\", \"fd07d52884766c5f40d8eaa6f0aa30b472a0ad2abbcc1ea28b3c29e1bc830ab9\", \"341bf6a6d36816542056a4e69a97688d7327ba3da6ef0cb40ce9d8b060fd969e\", \"46d78ddb1b61e22a7487c9bee31ad2165a7f0b1d022f9d65a7978fc2fb7ff45b\")",
