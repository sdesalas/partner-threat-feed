    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Walnut Spool botnet sample, as reported in campaign PTF-03763. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Walnut Spool Botnet: Process started from known malicious binary (PTF-03763)",
        "note": "## Triage and analysis\n\n### Investigating Walnut Spool Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Walnut Spool botnet in campaign PTF-03763.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"2d765131378d152a3c4f7385f5d5193c0be4f46b044bfab5317953e4e867c13e\", \"f9bab1958f75bb37609f4faeb77a55f14c528c4d80cc41b9b20aaa06dda3fb00\", \"289bef33cef67fa1f8bf4d08869450181e65a169d968e67583d4623dd0694a21\", \"cd2e902775deff11bc5371cdc10f80a67cc9082768329c7b459ee5ddeb87ad83\", \"cb8e88b3cb13da73cd1076367629f30b2c2d3a1c17d0029bba411b72e1ce027a\", \"eb6b5942582d26f32c01e741cdf8ed27fd86e3526378914afc958b6f3575360f\", \"3a7ff4e923e11db4a4e41b28c01583cdcca92d8266fd3801c04dfdd33c20541e\", \"654e278c54132dbe5e8bd1f3769761bebeeed6eacec201208847517526299bb9\")",
