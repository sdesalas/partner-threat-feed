        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Oaken Trellis botnet sample, as reported in campaign PTF-02378. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Oaken Trellis Botnet: Process started from known malicious binary (PTF-02378)",
        "note": "## Triage and analysis\n\n### Investigating Oaken Trellis Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Oaken Trellis botnet in campaign PTF-02378.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"a17c27fe70920ed40ab879b9da0cfe006cc993236d1e54dcd387c7819d335314\", \"9c81a9b90af0bddaf610ca5c81820cb2d93d98bbe6f42a75167315d2e127f0f3\", \"3fd81b4874e37b9ddcb80984053ce69cffcbc0ba26cba53ea58349624d1d6e38\", \"44e724329a37fa18848320cdb2eecd0ef889cc6c6e342fc02a892ee30a1a612c\", \"ced65ff561de2a6b342ff6b110518007efe4fc823775c1b17475c122e7f33fe0\", \"20f201cba7b2de16b20c2069364449fd2278f6409d77cd6213cbf71d58b0cbf8\", \"536f55cc915082389a70ea7d84e0e0ed277f078c0079832f36d8fa4719520933\", \"7fa7448514938c683abf4e7507a51bc99262228eb08e95267c980cdc03e85fd8\", \"05f0f05f58df8f20352bb1fc6603bec5fcf9dc35a189f133d1eafb7056ea4aeb\")",
