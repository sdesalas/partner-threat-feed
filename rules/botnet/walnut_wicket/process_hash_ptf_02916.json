        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Walnut Wicket botnet sample, as reported in campaign PTF-02916. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Walnut Wicket Botnet: Process started from known malicious binary (PTF-02916)",
        "note": "## Triage and analysis\n\n### Investigating Walnut Wicket Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Walnut Wicket botnet in campaign PTF-02916.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"019caeffd0ce9f78366565bcbf6bf1ee5500ad88e686a3e80994c36015629804\", \"ddd01679fe754e470536605b08c223e57b8491fd12f9ec55e0646e33278ca6c9\", \"c14e95cc5027b32e5540e5431d1b08a40effdfb0d63f33bb72d648abf59bac22\", \"7e9915ca221f151c8a11cf21eb1cd76c0a83401d1cb9a88cc4bb0e5f138cf0bf\", \"99e0b83f081fce2199cba505555dcb8786d96d1038d83d1451299584699332b7\", \"c7ddea1cd88980aa661b81d30a3062201e34aa1d7c4846973e82721dca83ead6\", \"f33ac1a6c66e4858d2043f01406f2c00fb19444d04a54950cbcfd8d2aed639e9\", \"9cdb9255d8c7d7d23190432404f0b91d37958e7535062251d447a800d9a3e9c1\")",
