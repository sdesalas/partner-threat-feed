    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Marble Sextant botnet sample, as reported in campaign PTF-04155. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Marble Sextant Botnet: Process started from known malicious binary (PTF-04155)",
        "note": "## Triage and analysis\n\n### Investigating Marble Sextant Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Marble Sextant botnet in campaign PTF-04155.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"7c46180490b2161737d9b3606fbe45f58785b745c63d5f67084e16060b2839b3\", \"ba932e502b53936a60aa57220fb45cb9c2a583147879630990b77ae58d0b0234\", \"882f31a9749e20eaa433df8613de76f118ce85add45596a80e23ea1e7e76a58f\", \"509710adf806314f5b9820bce4b8629149a660ea0b6634346604865d2d6074ac\", \"89cfea476197d01c104c9886872bfec2ac3f011ff5df0fc30aea19a577e1a910\", \"ecf1856e27ffe52a7798191382136f349d8fb675aebf4c47d1ec05b5c02b6c41\", \"0a80af65a576535dac30a8c7acb2c333abc7054979f3b6af57634e957df6376d\", \"971d4ada45a58cd2d62bb9af269bb02b43ca41d9c8116bf7495fb1d53e6d9546\")",
        "references": [
