        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Ashen Whistle botnet sample, as reported in campaign PTF-00164. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Ashen Whistle Botnet: Process started from known malicious binary (PTF-00164)",
        "note": "## Triage and analysis\n\n### Investigating Ashen Whistle Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Ashen Whistle botnet in campaign PTF-00164.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"11fb7eaef93a10038b91c54231bcaa76fe6b1889d6b8938fb06549e6cacef033\", \"f48191f5173c3a781bdd3aaa1545e2c30a8e19e71f35a1ea06e7f746009f16ee\", \"68e3c98d2478d0e620b40930e68557dc7a3032e3c88469a2d4a84c2081600a14\", \"cf5db949c118825d3b4eb8504c63b3735bd188d301edcaa9778dff373b82b8c5\", \"20fee34580015a65a36a1ea9af2f4159f1367506a8d70fe30baa724587f34169\", \"dd36ea0844149515af200da46a710766cec2f1b85faf5ec85dd2601335a9a167\", \"98dd46b3bc0884458381628aaae9d428970b61b7c294275f48faa54402b8c581\", \"b7b25d503d5689e0cc40d3bf382f9abcc459467cfda17aff9ecb450c523f4d4b\")",
