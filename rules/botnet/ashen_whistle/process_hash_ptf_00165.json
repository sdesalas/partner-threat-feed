        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Ashen Whistle botnet sample, as reported in campaign PTF-00165. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Ashen Whistle Botnet: Process started from known malicious binary (PTF-00165)",
        "note": "## Triage and analysis\n\n### Investigating Ashen Whistle Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Ashen Whistle botnet in campaign PTF-00165.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"197f726ec07e8aa1aa4089003b5b215526a7b658dc9bcc001d969dbd3c6620cf\", \"16d175b55a5234961791d84ce8267036437185f5b6edcf3f10b074cc2c03ce36\", \"290f26c18654f774d1a83c8df0f733ea444d29bc29534c2d8f61854d06ed870f\", \"0898be0e7891a9a74da87c8602fe20c641a6c0f7ac344ade980e4c748b6cf4e4\", \"bc8ebb25a6d4503cd1b7b33cdf8dadc6be260480846ddd36fdfcc1cf2181bf92\", \"1528677d3b1e4cda6271a55883a6c641d374405d2770b5a3068038110bde16a4\", \"12e16a26b61bb96e84308e78232f7052a4de8b02337da389559ba57273a488a3\", \"fc0d16f3ce16538c7b3aa7ee879c99212430d1b7a3ba95cd13ed32952c55217a\")",
