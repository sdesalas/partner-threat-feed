        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Ochre Satchel botnet sample, as reported in campaign PTF-00604. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Ochre Satchel Botnet: Process started from known malicious binary (PTF-00604)",
        "note": "## Triage and analysis\n\n### Investigating Ochre Satchel Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Ochre Satchel botnet in campaign PTF-00604.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"487b441236b8d1c86391125e6c62b8012133c8853edbc7853cbdb9ecfed98130\", \"3272727ff874a1752a2d03f15e104bb330b17aadca75e99472f5151890019b5b\", \"94d6099ca41278d55455816324ec9df06be0403d4e0a5cef6095b45d781c782e\", \"975acb4f8f85d9001a4fc3c5fd7595523b651600f01c633ff602736983f34c6a\", \"1e31c78d2891cb90001dd7bf685e45405dc0b5ed17a13feb46b45e24d07a0849\", \"cd26b5b80c35952435297f6b6b873a5d8dd567fff813389945cee7055e18f573\", \"b960aed4e8cb3caccbacb6e5c71a588a40c6641fae5c392932f71c47d01519b1\", \"93e005e61abf0b70e62e333dbc79a8a48fe391bcb8b1efabcf96fe487b0031cc\")",
