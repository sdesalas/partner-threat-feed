    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Tawny Kettle botnet sample, as reported in campaign PTF-03126. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Tawny Kettle Botnet: Process started from known malicious binary (PTF-03126)",
        "note": "## Triage and analysis\n\n### Investigating Tawny Kettle Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Tawny Kettle botnet in campaign PTF-03126.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"5a9f17d23e9f7ebd9c44a31493a97df609b93072f9e8e057b891222b1df5aa5b\", \"31f1e1c4d0634e70f8325b287eb13b8defbba0fb999e3d08024d81f649a9defb\", \"36f34d26d8286b781ca223303b94c88a3a67a40a78b2dc7c6e111cd118da5685\", \"1caa7ed43d67eb1350f555ee1b6fa2f47ba404df894e5ccd6383549ab7ef4a10\", \"a0c3f3efce8c502935c0a57bcd0f6b864990234d63fc9bf3899959c23d60099c\", \"afe49b17aa9776fe7e084a514cbd0912e29530a69fe45acd32ffdce2e25954a0\", \"d115dc78f3f41858b2f14f006e7d3d1320c926a0f537a264c7d6bd98cc825df5\", \"529c72a393405f694349c9581b7d7315d0c29d000590dd43e27d466fcaa309e0\")",
        "references": [
