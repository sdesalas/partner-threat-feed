        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Umber Loom botnet sample, as reported in campaign PTF-04228. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Umber Loom Botnet: Process started from known malicious binary (PTF-04228)",
        "note": "## Triage and analysis\n\n### Investigating Umber Loom Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Umber Loom botnet in campaign PTF-04228.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"52c983ed804d44a12acf67780748d5564f4d36dfb676ac8491057f5290120217\", \"bb9fc82148bb618b0213406376de7cfceafc9fb98b60fc2949f5398b6f802125\", \"7effc19efd52353c74e16b23208f448043a78fc34e8f420c8c9a05747b627e6f\", \"43cacc6819e667289a5e45ff2163ee0096db791f034da806781ef76f0679bd01\", \"49cc0abf171a6fe03465b22518a344d908a7e1a7b5c0c5fcbc4ee091ac077d71\", \"61837e82896c6271164ca9920f5e897796d7aca577026a20b0b4493032aecd49\", \"a04ab071a2dc7d7afd3108e8d5d55b517a7b9f357f197f9b703c8b029261694d\", \"2ffd8137067ea1e6822a324790945e49527d835d6accfca898130b545af35012\")",
