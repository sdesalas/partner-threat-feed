        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Ochre Whistle botnet sample, as reported in campaign PTF-03498. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Ochre Whistle Botnet: Process started from known malicious binary (PTF-03498)",
        "note": "## Triage and analysis\n\n### Investigating Ochre Whistle Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Ochre Whistle botnet in campaign PTF-03498.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"6b664e668db42022eea7789fd2d19274df6b42e245d09933b57d4713faf751b0\", \"90d383a223a47e37fd3e830e7c09dfd0c68ba6bf14df316c59593e8d70f437d1\", \"39ac03df059c1475913f80e4f05aa6bcd491265013c62722583fd330e68c05c2\", \"425e7e96844829e4a1e821a22afb464b9389c6381f577944556add1e6a068dc6\", \"03ebb0d966919cdeafc04ef5782d3058a609ba23eb08094bf3ea1973c87635a9\", \"251d8fd9ce3bf955be2bb48214d7dd5bbbf3bafa209f2b5ed7a7d93eb5ead517\", \"fa1b30a4bfa96cb9363059dc381a633f47482876622215b6a9fdd04e7d1a7d74\", \"26e3331cd41fb753518cc37a57d13d271ec0c5949f30c5bff167eb5740c6cf07\")",
