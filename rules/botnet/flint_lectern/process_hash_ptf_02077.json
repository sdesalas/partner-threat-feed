        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Flint Lectern botnet sample, as reported in campaign PTF-02077. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Flint Lectern Botnet: Process started from known malicious binary (PTF-02077)",
        "note": "## Triage and analysis\n\n### Investigating Flint Lectern Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Flint Lectern botnet in campaign PTF-02077.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"e0087408d451031475f3d2a837cbbb402dd3d04ffc062fc517d62602d21da1f2\", \"085c758538843f68867cfa55f8b513227e54b445040dacaabdd16c842fc16d3f\", \"00ee0faedcde5912870f688b8875078080360dc36d2cb88a9b04978c58a29edb\", \"7ba903697a825465746cc4718c4b92d2a0ba8a193e9f7e341c3ccc9e4b4eb1e5\", \"b5401a9d8551ded1f7d279ba3d45ccdba40223e4e8e6c36327457c1dfebb97ae\", \"437e2cc2416151f09343c2144507fa9376e5f37b2003d91c0f6d9e12d891fe4e\", \"99f6f5045172cacd052201bda06639d2f5efd410a73156a23c4c01f9ff06938f\", \"26d533ef4eea328b00e185922a1c64b2f887c27b2ead5873f2c2e77285576295\", \"bdf97990a1c71b6289a31322cef45daa39b0fc61c17f3a3a4869a2bd51ceef48\", \"663d7020c4ea7e1b478a593a9014fef038e29bcfd13c2fedd59ca85a6d1af0bb\")",
