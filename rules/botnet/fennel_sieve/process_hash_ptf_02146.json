        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Fennel Sieve botnet sample, as reported in campaign PTF-02146. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Fennel Sieve Botnet: Process started from known malicious binary (PTF-02146)",
        "note": "## Triage and analysis\n\n### Investigating Fennel Sieve Botnet: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Fennel Sieve botnet in campaign PTF-02146.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"d73b505c93631cc46d388fd8aaae756557462207628ae0e98e9b2659e229cfe4\", \"78dc73e6624bdf8c430a5b2f86c84d4b7cb69e2764d5cd5dc6054641f31c70ac\", \"76a81206e24934a5f7517fd3acdb823bcb29ee6af5f501367a8116168f9bbeb3\", \"32e3783d8da958d44250703d0445c35c0b94b42d0a70fa35932f0269dea347f7\", \"2d13fdcaa49ad1f6620ca27d64381e736e9d1f2ad6425d4cec91bd2686d6cb19\", \"327177be7f0290204e037fd0ef54a919a6b92e7e2186e3ebd088e564222826b4\", \"f4c78fd9a48c93fde220bdc2651c03a818d03be2bf0d98ea271417491fb0a677\", \"491c8ab17c4041b71365a3fc7714c2a92f8b5970e8cf20f080e09bb699dc4c57\")",
