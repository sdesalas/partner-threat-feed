        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Juniper Wicket remote access trojan sample, as reported in campaign PTF-01817. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Juniper Wicket Remote Access Trojan: Process started from known malicious binary (PTF-01817)",
        "note": "## Triage and analysis\n\n### Investigating Juniper Wicket Remote Access Trojan: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Juniper Wicket remote access trojan in campaign PTF-01817.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"255965eb128e2de3cfae50c8a7a55e7bed83a69c5cb16f718ec36117d5fc88be\", \"657af3db85f35e364901f9e9a2768b7cdae92f44d0cf44002552b5d552709c0f\", \"9ac7336328c1a8c6f7152c01b9cb033a281506b1f5a8a890f369384a969428c9\", \"680182095577ad27035dc2b2cd228bf01e7f7ca61f779601a646598c30f897f3\", \"0940ff97f6234ffbd609e5e600bba106d8c983b4bdda670ca3fe0791e516b669\", \"62d68c9db211b5c03ae71ddcaba18e8c7e840626292f3fa32af8889ebe35ad6e\", \"5b8536e89b1aa605b1cb392b2cce10b3d560626aecb1603d2c2225c1a8444b70\", \"ee40831e14dad754d82fa7132e7a36151e042afbdbd6a973c93d5d27fc33b391\", \"b2b3c85c620bf37fd885f390b1390928d2b971b7b8d7c9098eede79f3a658f5a\", \"4ae0aadbc71e9cab12d9b787f3438fa67e4abee2bdb6b75d874b8e5fbce81583\", \"6ef2392657b342d943efcce11a4db18c71e1e30b4e25f1833c8cc1b8a224e2c3\")",
