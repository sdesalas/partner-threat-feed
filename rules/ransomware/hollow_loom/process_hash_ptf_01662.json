{
    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Hollow Loom ransomware sample, as reported in campaign PTF-01662. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Hollow Loom Ransomware: Process started from known malicious binary (PTF-01662)",
        "note": "## Triage and analysis\n\n### Investigating Hollow Loom Ransomware: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Hollow Loom ransomware in campaign PTF-01662.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"db5e6c327c871494018e2dae2598140204b12d2bbd45435db35a4e5dae53100b\", \"8c7d20042d2880cf01256c2b8faff9a675355ec80e3f9593f857c1eb4a579fe3\", \"207aedbd1c5f07122892398b0150f4303aded36b158cb8df5579d5130fa53920\", \"3ec7055c2b705c5acd04f91b0a3a6fb097e10a13567d8794c6a33ed5bda81f0a\", \"54960ea20235563cee1f6f093ab45ea0211cb6d28eb90ce7da2f556c15597bb1\", \"f4ce3725f3f431dca858407a0ac91b5531fb3ea48344bdb3932d00085ffd668f\", \"f54cfd2dd69b19e0e095d4d2b0f6abbb1dd35a74d46bd9248daa62bd1e722021\", \"6ef14101e4f0249956612f32d13cafe223e3d7471a9586e64b4b26ac7fdc6509\")",
        "references": [
