    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Juniper Gimlet ransomware sample, as reported in campaign PTF-01739. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Juniper Gimlet Ransomware: Process started from known malicious binary (PTF-01739)",
        "note": "## Triage and analysis\n\n### Investigating Juniper Gimlet Ransomware: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Juniper Gimlet ransomware in campaign PTF-01739.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"f55a7fa2f4af701f70f756dfaeb196d50518a393f209ab83c6ec25687a019db7\", \"b873f4d5ee3b5bfc23896917dcdec1c9845fc656e30c2d0e515b1cec966ee7d5\", \"30ab8493e6e6613300e71521090573685e90950566875fdd72e32718209a668e\", \"96d3a40abaf74401c5ce7eb963a98b0b806288c09e855211555f08f92d7f6fc4\", \"68fc3b98be26c965a9109d36e8e4e60c7096263ab03a2063bffb907214129944\", \"b56b077ba6cb3d7c022ece9e8243dd28f7a1d0c90670af94477f03df7bfc6877\", \"fc87d717270d32be8fd0f4b9ae882cb7fe7cead430fd384e68aca2e4fd3cfbfa\", \"2b236a149ba795c648b005062ee7bd4f83cccf76a82d427ff8b4c4be33a1925e\", \"3ac982b88f917f7921919f9d6c078ef69a8734ec4d0804825b6839aa5c5b1e11\", \"2962bea438558afe328b4d1cd2bcfaa4ba7a70ed7a45c43c5927cf680e4467fe\")",
