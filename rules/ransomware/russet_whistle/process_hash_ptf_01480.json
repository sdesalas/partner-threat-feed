        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Russet Whistle ransomware sample, as reported in campaign PTF-01480. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Russet Whistle Ransomware: Process started from known malicious binary (PTF-01480)",
        "note": "## Triage and analysis\n\n### Investigating Russet Whistle Ransomware: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Russet Whistle ransomware in campaign PTF-01480.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"6863251bfdcb07a33e29dc36039b9eb5e3f54a067ceaec75b4dc0eb63d21bb29\", \"37d6a5f7ee8c9ff9436191c1171d60a835c51df6edfeff1c54dfebe1bd433cdb\", \"4ffd9f72d6814b0292edab86865bc2839e703bce5231d696004b8c89d67dc6ed\", \"7490a207351a1f4d361d4ce03f22eb7267e2ef3600bbef7e9003b12e6ef3cf6e\", \"9d8b6891dea6346e4c3f68485f65bf792da809f6aecdeb70a8328f78d45be8e0\", \"74221bd85b0bb247b0a495bc99ad98ac229b45e187ca92f627656d2c0a9eb359\", \"7df5075e59baec0c319213c52c80e05be971dc7cdca2b5d64a15c6354ac912fd\", \"79b0f55d42d660680ec708b0fefc501234dc2d3b0607c0a0fd1c544bb0211a86\", \"bde914a742a7ef9b4f91d27de2924af6e7f89ebdb58a2f5e6e06c115d3558413\", \"c8ce78f4f0694d3752754251b8527d9daa309375e51376c0174342b8e3f26639\", \"34ada9c50b41444c118da2ee149eee72a90daa1ce699d56284631ee361b21106\")",
