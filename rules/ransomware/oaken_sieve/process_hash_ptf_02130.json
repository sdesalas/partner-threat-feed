{
    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Oaken Sieve ransomware sample, as reported in campaign PTF-02130. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Oaken Sieve Ransomware: Process started from known malicious binary (PTF-02130)",
        "note": "## Triage and analysis\n\n### Investigating Oaken Sieve Ransomware: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Oaken Sieve ransomware in campaign PTF-02130.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"73ec02a646d3adf3dc833c21ce566a24d279c8ee2cbcc22074665bd5703768e5\", \"fcc22d7f197d21bbba6ba2e96f97e098f8d591da69914b933536e991ecd8bc3d\", \"6911ea31cbeb1d1cda9e00e108abf1241489767091a22bd35b31e72839ca5426\", \"74199533e79a6b238b57b96e15bf25137bf0c70081c0e068569715d58c0bc58f\", \"37e8cca8ba9f47877c1868c95ade8031693c3b81629098eb3cefb1838f131cf5\", \"d95a6f9078d65a70ee987ae6dfc8c281fc7238d50603dd867191d9c4ec99b055\", \"a0f6fafbd970cb53980686161f482d9b4d1d0c2ba9bf9b9a33c220ad37449638\", \"39230ce3ffe42c1504b6d0e323dfbc96678bf5f01778aba4bc5f656f68b99a2e\", \"fdff5560a7585255de40d61f7ee76459ebfa65d880518116fb3266410f5029c1\")",
