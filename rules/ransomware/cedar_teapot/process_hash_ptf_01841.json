{
    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Cedar Teapot ransomware sample, as reported in campaign PTF-01841. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Cedar Teapot Ransomware: Process started from known malicious binary (PTF-01841)",
        "note": "## Triage and analysis\n\n### Investigating Cedar Teapot Ransomware: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Cedar Teapot ransomware in campaign PTF-01841.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"8ccbc0003edd00d375b8cfa68930298b14a9f14d1064705b498ec45714cf4e06\", \"821ad62e8c6e18fb4f36a06f3b5ec6ea57f630410ea0089a247732e679d7e7a0\", \"287e40bd462c0aade4526079b49933e1c5c2647d597257d75d74dddd083e34f5\", \"71bc3c551c83dbba1179d58ca8b8494db755c2f0a0b275b3874a14ffdd398e89\", \"90f93bf8b04d652ce042030b2b9a22dfd21ffa072748a65ff68e2ac7bec95cb4\", \"5c05a83c6ad5e8a911ad035192c8a0c21a07a08369f2f0b92283d3af0a2b1766\", \"4fe5b6132fc00254c117cfd7e024871686a5185910b151567299deb55fc9dfa8\", \"3bf02d1a8098a5687b44f9d653f725107476126ae34041aaa733737de13f2d61\", \"72b2a8d2c324ada7317735373a394213db9862fb6bcebcaacded4492d2a269a0\")",
