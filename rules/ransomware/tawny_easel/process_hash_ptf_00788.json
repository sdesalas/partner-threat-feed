    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Tawny Easel ransomware sample, as reported in campaign PTF-00788. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Tawny Easel Ransomware: Process started from known malicious binary (PTF-00788)",
        "note": "## Triage and analysis\n\n### Investigating Tawny Easel Ransomware: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Tawny Easel ransomware in campaign PTF-00788.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"747ab0f06e48660566865f08f558cfb0fb6da0f8276ae598668bbe5a3e174d6c\", \"9fe537817d7d6d026cddc2efc29de00591716c14df08b538f3f11ad74a263866\", \"88422fa8df26a527a108f65ba2fe698e42a5237970a18bf0a74c283e2f932562\", \"98c468859f4d6d31cf0ab1bd3f250c0cba2fffaacbe4c84dbb0f1f312cb1ff46\", \"8a68538690c3279fb92f6cfd99881170f605cdb833e355322cf9bc85323b2d11\", \"edc3142947d161f8570588b9ab6a95073f81e3ef20bbaf883ef6249510d86366\", \"320e1b3571887345dcd9d645af82e2a68169f073c30a5e94afad3d3e9d73b311\", \"b7006a074472f07daf397b0ff0f103a670282723021af4d3a8260a196798a04b\")",
        "references": [
