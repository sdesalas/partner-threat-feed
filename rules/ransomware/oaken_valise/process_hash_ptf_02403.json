    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Oaken Valise ransomware sample, as reported in campaign PTF-02403. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Oaken Valise Ransomware: Process started from known malicious binary (PTF-02403)",
        "note": "## Triage and analysis\n\n### Investigating Oaken Valise Ransomware: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Oaken Valise ransomware in campaign PTF-02403.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"b08ea3f0b98c213fa0fea4feb9e39200300e86384efee5b8148496a9f81d3f12\", \"ec29d77dcc90c04c307972254780ba8b4f065905df9eb58f8095f20a66ff9a84\", \"f4ca6a4f600f14afe4826158e97e4ac2da714072ca27a84278ecc9d438e4889d\", \"f73253bb6e31fb71d099592d4fd960114fca307cb3bc040f60252ae7177a625c\", \"ced025377d8bd4e4dcbd6d51d365660b56f7a2f202ad717d0000884e5ca9b9d4\", \"a3d3033dd5818ba1f1c174be995dd789d6faf0a4307978abc80b78a63b9b2afe\", \"329f503873cc54e062cb71c042f9f8021a93db934dbc43787787256c699a58c9\", \"76a9457744d3c9889748d5ad456b668c74c7933e7f6e9a175f42f7e6fffca65c\", \"4329a51f8a69cf45abc79c7a6d9bf1b3baad5610ed41d915741feaf0d67c5659\")",
