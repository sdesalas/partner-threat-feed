{
    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Flint Ladle ransomware sample, as reported in campaign PTF-02735. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Flint Ladle Ransomware: Process started from known malicious binary (PTF-02735)",
        "note": "## Triage and analysis\n\n### Investigating Flint Ladle Ransomware: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Flint Ladle ransomware in campaign PTF-02735.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"9fcb946946bfe369374c51c362e2b8e6930c6f7f8aa15a93771fc981e86431e7\", \"e86672a9d01474c7591e7732b8b8a7137b2345341745878c6e569e08b53cfea7\", \"11b5bffe02ff81b37e4b82b35a98b92c2da95080a33dcedd7e8a7f12953ec64a\", \"00e697ffacdf1a8b9a2965ec7e27129868c06361dc1ff5e9052e44fda92353b6\", \"98401838775dfa4f3c618ad80914e79f137c4547d33f5c746b8d77f390a08a4e\", \"611d1fcd82db841305db3a654afd3f81362578903da7a4e905f55e935cffd395\", \"3c5fb281ecbc46914c30329110ddb5349637aaf815f9a689a33dfedd5c291db9\", \"49741c2754e5f2ffac103febda452afa9b58b34d4d9bd97a9fc4eb38ed6c5c2a\")",
        "references": [
