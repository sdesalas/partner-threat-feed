        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Ivory Bobbin espionage toolkit sample, as reported in campaign PTF-01619. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Ivory Bobbin Espionage Toolkit: Process started from known malicious binary (PTF-01619)",
        "note": "## Triage and analysis\n\n### Investigating Ivory Bobbin Espionage Toolkit: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Ivory Bobbin espionage toolkit in campaign PTF-01619.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"f0dba6d461c2652352ee828d655abce8c45b08870650d6855a33df20aea73675\", \"b2c7d8949c4bd8512c446508b68a40b9968d1daffcd2fa7164f1d7fbe6466b60\", \"5b1aa70aa167a5e5142e08319a89cce38e305980f5e90a4cd2bd09656eef51dd\", \"5fa48a3f668c1c57451cd460862aa01691222049e3b2e8a82f25d8124ba0108b\", \"326f67b0a1cce544f756ce950ee57277e4ddac86a875f96dce4874d603095f05\", \"cfdc415289b9d136ea2dcbd20a7f01e69e7f683a6123ed64ffa59613f1f2394b\", \"27cb4d1f261336caa617b208563b75c2902e261a1c8dbea1f87d721dab722480\", \"b63f9d47c9786e396565f0ef2eb2ea23e34ae6a62f0833e04eca91db25ab52c8\", \"1ab94bd212cce27290e3a13e28d530a71a9c721d710a221605553d7d199e06d1\")",
