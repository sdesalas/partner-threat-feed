        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Copper Tinderbox espionage toolkit sample, as reported in campaign PTF-02475. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Copper Tinderbox Espionage Toolkit: Process started from known malicious binary (PTF-02475)",
        "note": "## Triage and analysis\n\n### Investigating Copper Tinderbox Espionage Toolkit: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Copper Tinderbox espionage toolkit in campaign PTF-02475.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"a21879f3d4c2ef71dad1a5a4944b66216d4a2d04c0e741180736aedb42e223cf\", \"773c13076a9459a4fd753673767c4af33cbe9ba9a42fe08514165e4bf29036ad\", \"79e6f4f828fb9f891881bc9c9467e10316f30ea6f7b6408cdbd3c4d5d2cc6733\", \"32a4a2a5abd5a4299ef79fe79c37f7663d908bfe17bd270ca984f59b090a4759\", \"ef9241eac2572eac408d533296bdd6860c049793aa3e3ae5cc6ddb0c47d3daef\", \"c1adec11046a49f26b9998e0f8d58630b3551a4097ed89ecef017e4a8da8dce4\", \"a9fa2965a6ae598d660ca5fd6648a25085185dbc1c31beee1e6c7410941c2478\", \"d3ce0ac3fd7ccd428d3c2d34f456718c1f486c1c5dd263f769d1bb30811f2eca\", \"68772ce95d2ebe2dbb972835a2ad6310a5515ca6682a00503067d7da8e831435\", \"320a643d48f12b4622e5756d3d458bb69fa9a19d360dda7eaffce590228975fc\")",
