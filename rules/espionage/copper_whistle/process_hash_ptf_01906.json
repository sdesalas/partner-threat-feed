        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Copper Whistle espionage toolkit sample, as reported in campaign PTF-01906. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Copper Whistle Espionage Toolkit: Process started from known malicious binary (PTF-01906)",
        "note": "## Triage and analysis\n\n### Investigating Copper Whistle Espionage Toolkit: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Copper Whistle espionage toolkit in campaign PTF-01906.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"317dafc7341466ede8829fdfa6c820ff3925f4d08dce9fa91421ac5e2c7bd832\", \"7996fd2b5866d5a0c6bf173f5909965b937f8f4598241e2c6b7463dd9c76b174\", \"a196fd1c80dedde2aa29082cb5ef44e3f0ed3e7b832b2ac8b233aec8f639f5a3\", \"835ae9b1af1c86d61e2b39e705b88dea4db6aacbe9bdc62260f9bb44d033cc3f\", \"35e591a9816c8167934c4578c25870325ddb23acf49743b928a24bd60536c482\", \"90c7ff0f116f6f7d6c1f555427490f719609cf6613fac62a363b9484401b654d\", \"b25039bdb71ced0b6a140c258e6edd18f9c8ac895dcdb7edafd000fb638c3213\", \"4760710d1750654b035e54c6c2d2be71611a006457e8f13a0fad5ac5bc20e8cf\", \"673ec0b585b5a631d72ec9a5c0f9d69c82629dd93b73f947bde587b00f92d7f1\", \"d66d1d17dcc338d0a92ab24a5265510e80d82884da24fc57f89714da86d7b609\")",
