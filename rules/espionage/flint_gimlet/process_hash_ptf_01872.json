        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Flint Gimlet espionage toolkit sample, as reported in campaign PTF-01872. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Flint Gimlet Espionage Toolkit: Process started from known malicious binary (PTF-01872)",
        "note": "## Triage and analysis\n\n### Investigating Flint Gimlet Espionage Toolkit: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Flint Gimlet espionage toolkit in campaign PTF-01872.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"52ea43c151c8c2c41fd63fc16272a72a8dfbc87831af91f048c61a4d75f1435c\", \"453353a41652a6fc64992ae672cd9730e05ae59dac91f4f42bbbd5757e3a301f\", \"eb335ba7d2c6c1e8cd75064ae24efb632b08f47c69f86d0d1ef81160d689d9b8\", \"819c675c8d5951295a727245688edd34a041584fba322f4d5e89d92e1c6a243d\", \"673cf7e30b48e4211720600f71848de0dd47f44385fd36cb055f98057c6a818f\", \"0ce1910ba22a788f4afbfa0238f58f51d43ac02ea2ad93c625cbf475088c0618\", \"be197365ad52b059e88d018c0978656e4521bb0989c83fb7a9980e5e2e35bbef\", \"29baa987a5d92f9a1cabc90812abe8343552a86d5ec1e1b516ccd644843e60f6\", \"45c8f9ed349d4f2be6f2c13164b404c0ce1f83c037f45a5a64ad74f87e80e75d\")",
