        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Ivory Valise espionage toolkit sample, as reported in campaign PTF-01985. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Ivory Valise Espionage Toolkit: Process started from known malicious binary (PTF-01985)",
        "note": "## Triage and analysis\n\n### Investigating Ivory Valise Espionage Toolkit: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Ivory Valise espionage toolkit in campaign PTF-01985.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"2c61c51131efdd52be650d7a3a0d4d1e1ea645676072d3e0764bdb609a109c78\", \"7563bdd3554743444a9e3965f98526cb957b7ad349341989e39330fbe7f011dc\", \"4e811b2b3c17f540776b906980399f2f9d81501451bd8421cf37d5035908640a\", \"e95dff34c1f4789458f4eee35288d04051c4db92250b5d9ddb6a285f07f14d9f\", \"7f86fbcb0a9c41bc878f260a669ed109ec0e684ae1300e868afe880c28b34eb3\", \"e282bba15cf679af288b67c6c386c5f8999fffb831892c8f25c602436d305cb6\", \"acc778fae06a6e59820229ebdaf66ea304aab929b6e11d978e8f82ca38fcf4d0\", \"fd459930f30583618be0e8f470b0d242ea1ff910f790912409ea8cf068dcb005\", \"7282591b921dd55f27d08919b505deeecac735490db301de131f02025ff4410f\", \"f857ca3ed4879f104b6781e3c415c7e7e4bd87af7c2ddef92b0dcbedb3fa6b11\")",
