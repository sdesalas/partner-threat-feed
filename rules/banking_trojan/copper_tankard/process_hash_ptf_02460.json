        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Copper Tankard banking trojan sample, as reported in campaign PTF-02460. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Copper Tankard Banking Trojan: Process started from known malicious binary (PTF-02460)",
        "note": "## Triage and analysis\n\n### Investigating Copper Tankard Banking Trojan: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Copper Tankard banking trojan in campaign PTF-02460.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"c7510e219142b73ccab5b7663db5bf8cd405f8b56b4f94bc5f84f423cc4f4a22\", \"76544513374b1643bcc0a6fba1824c3ebb97d9d71e746a2349a1f2611140527c\", \"e67cf0ece65447eb0747f639905a80b55b2b50c28c678837dc994a99e3953c10\", \"4076c225430a0e7ae7a0afbc5deb9a4149529ca510bc48acc3eb5212597f107b\", \"1264a60f2649fd3f66a374a07bf3b679c36d21f8b3b87b423999df5adccc7da0\", \"cb912e3af2de0962584c24567cb8133b268490d543b938ad86736ee2e245a151\", \"6de286eabbe32afbee1ccc747bac7c84c9c2a30d0f2cb5fa9b2d86a1f2b992c1\", \"c0ef6e32636aed3e264ac83c4c30eb92f1bcb15f3cc562d1d36507306a075d00\", \"9204bc07aea7b3872465891ac1154751c5f42c7b06eb4114cc112227f8fb8c66\")",
