        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Saffron Bellows banking trojan sample, as reported in campaign PTF-02042. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Saffron Bellows Banking Trojan: Process started from known malicious binary (PTF-02042)",
        "note": "## Triage and analysis\n\n### Investigating Saffron Bellows Banking Trojan: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Saffron Bellows banking trojan in campaign PTF-02042.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"23f97b3aaa17429f9f6ed7eb1dafc82e80196e4c7fca37130725aebba65cf330\", \"aaa68964b533d9f96f51aff5e8931d23fc7da7c9fba23ef01819e5fb969f6cdd\", \"93c9f64f0b3280a8b004fa599c4a31840013da5e9d789ccf731cb2e30a24779f\", \"2a23243499cd5902c7e35c8a2ed66853a43c243c57a2b63873d11dd9da910f99\", \"5a761390ee9b0951507b248956fd4133a020d361ae5c581d2e9892719bcc21a7\", \"2c843819a8c505676011405a6e0fea51f676f31661effb0c68fa83ef385624fa\", \"f207ea94721d0ecd5f94311084c92374c0b4f0cbc43d08332a27ab90cce375df\", \"6d89cf0bc9182fa5768c382eccc57aa4f79859c91cad3f6bd71630db1c7353d8\", \"92d760941e691dfa6ada86bb9e6e511ca07c4ee8905e9cc99debfd6b5277e591\")",
