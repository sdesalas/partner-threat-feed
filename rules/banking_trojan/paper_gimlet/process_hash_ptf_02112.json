        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Paper Gimlet banking trojan sample, as reported in campaign PTF-02112. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Paper Gimlet Banking Trojan: Process started from known malicious binary (PTF-02112)",
        "note": "## Triage and analysis\n\n### Investigating Paper Gimlet Banking Trojan: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Paper Gimlet banking trojan in campaign PTF-02112.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"cdd94eb3ada6aaf5a6e21f969ed3cf189390d399c9815ad7822be71be7f5c8d9\", \"295b379bbe547b34698ffc34c60d4b39a57421f24e1733ccaee44b5922f79d65\", \"c146870ecddf1b978ed544f892ecb4b8448e28cb737317c5c036b4b114d4c72b\", \"142aeb90d2cc111976033bcf3905cb8cb0e6b54acbc832712a50b81d29aea009\", \"71983d2fe2630869b28f2049a9537dec6d87641a9600cf5d5c63fca81bfce0be\", \"e0710cc1124c66901be7fc3d4f52361f51f40ae1249a475f1c501aaebe21e40d\", \"e8e81734797151dd2561d0674cabf256497ad290f881fe3268c1bf673a0c0e33\", \"fbf69fb8b74d619da3716fe4b11d20be48c0e1ff176387d929e9b6d8bc1bed20\", \"8c140e9e73f1f862901c5c532bf70d0100629926cf5c18c2a8516d514207ffe8\")",
