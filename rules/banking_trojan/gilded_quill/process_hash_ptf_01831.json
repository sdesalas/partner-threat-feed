        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Gilded Quill banking trojan sample, as reported in campaign PTF-01831. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Gilded Quill Banking Trojan: Process started from known malicious binary (PTF-01831)",
        "note": "## Triage and analysis\n\n### Investigating Gilded Quill Banking Trojan: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Gilded Quill banking trojan in campaign PTF-01831.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"ceeaad6d3ba75883ac18222381a779c5d9b5532fa9145279395095da0627460c\", \"bca2a37396b04025e9aa0cf19cdcde1f8095965512c7e9c803e69b4e9e44faef\", \"15e32d701ee64062f7f2c45174fce4986348b55889b582cae59fa937b590192c\", \"4f99579300d340cf36ebe7882712087ed5b5b2db5e6856e5604f62527481c877\", \"13e65fc7113fe8df9169a9c47740b2fd306836a7b5289f3d4911ebf8a15e17af\", \"8c38f59ab03d677bb27b9c6c9326d83ce9385efcaa4e1c4b867ec2e81ca45743\", \"495814d8e15a9ef0ca42a0d7b11693ac6bcda04ce661bd84284729c5f15f9ec2\", \"cd9a98a5a04e736b9fdba28ea7ca95b110e3763f93399fdb116ee48bed8021c5\", \"7fdce28dbf79fe49a728df9b11a994d856f799e31845fc5ee8f9223c8d8ede8e\")",
