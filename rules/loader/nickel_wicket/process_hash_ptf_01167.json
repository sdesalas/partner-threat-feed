        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Nickel Wicket loader sample, as reported in campaign PTF-01167. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Nickel Wicket Loader: Process started from known malicious binary (PTF-01167)",
        "note": "## Triage and analysis\n\n### Investigating Nickel Wicket Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Nickel Wicket loader in campaign PTF-01167.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"8a66d467170626c2e35007f05c8026a37458268ad8f7040d4d07cc005e78e365\", \"121d98ec1906b13c8bc6750211fd6d188732723c584b5805f9fb12db389373a1\", \"bac3ca8bff6f2dd02dae7f2f7a0f2c23e7fbc8aa171ec11e1f2a17db343635ef\", \"0d5848b4241d8d483e7a24201b4ee42c77e9855c4194d443cb3667d2992209da\", \"656725aac51cc94f80d12f8e7587ee5a7fb5beb8f0c4f4056668e567633cb983\", \"fe0f8cb5de23c6170f81632268898589632e2fb1ac9df2c8510c0999e8b1ce09\", \"d317520e13d5037d3cce8b9b85c725027fb500ff9fe79c82008121c131f03033\", \"e2abeaf771dc974a340e7addfbe2b6bee6109a6b42caf2282a502acc7cf8fa9b\")",
