{
    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Lacquer Tankard loader sample, as reported in campaign PTF-00016. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Lacquer Tankard Loader: Process started from known malicious binary (PTF-00016)",
        "note": "## Triage and analysis\n\n### Investigating Lacquer Tankard Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Lacquer Tankard loader in campaign PTF-00016.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"6ec8f9e2e782e53d3bc50e45652b5155c1342109cac4a1db83d820ff18dc1ddf\", \"86ad1a99f70958f7ea94409059a5b16bbc6aea7c102df375469ccbe7d702e534\", \"085a6bb51d39b21d53e8e665fd71f18a265243a362df059257ae439f495c4ac7\", \"c4b6c2e8cdbf8488bf81cf079e1a7cef5708e5175ec7e52278ecbf3052404536\", \"811ac87529316ea631fbe375a21460a48dd3eddb4c14f23b230f67c69bb83a05\", \"ba31ef4d2f3c495889605ffdc51b1a50b1f048d7c7007c2aeb8676306f6a8071\", \"8717c2856af57cbe42ebb9042c49d05fd0ebdcfa21d49714528874c2dfa567e1\", \"fcbe13accc7464f301521b76643fe58f931f8a4e8b5484c44489458ca5289d27\")",
