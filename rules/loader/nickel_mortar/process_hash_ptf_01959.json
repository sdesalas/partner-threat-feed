    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Nickel Mortar loader sample, as reported in campaign PTF-01959. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Nickel Mortar Loader: Process started from known malicious binary (PTF-01959)",
        "note": "## Triage and analysis\n\n### Investigating Nickel Mortar Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Nickel Mortar loader in campaign PTF-01959.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"4d09345e02e058a904f842ea3a0b0f2cdd470031b153366a34c8fcd698885e5e\", \"e883292888bd9d32e001d61148cccf07ad7a39d54081bc14ab1ca18e0c96a0b0\", \"777ddf65081b32e73f35b5ae9a3285c9a4a0a22526e7871fd747389f0ebcbba9\", \"a5ea12b56d724e789cb1a4f243aa1d3d612d1e0ac5a07c8c25236b35fd0da827\", \"a8d641fe5c2d1044ee4d944f1fdddff4641e3837bd86dd5949df0c0def31d6ea\", \"b686abd58f67b97726edcc31f3550751c9e6937369abb339352d5dd9a016dc3a\", \"b9ec019da2e0d274140faee0c11642394a88644171dbec16e616ba82a98a6b8a\", \"fd1c690e87ad66a16c37eeff4508cb93de9f97222867202363d431a45e6d6759\", \"458c9b395c644a0f7631262f278085c54d3406c4afe407ec3ecb3c5b004db733\", \"a860c6be829d80b56019cb4da890b6ea42ae8d6abf18ee7358f6af91599e5d27\")",
