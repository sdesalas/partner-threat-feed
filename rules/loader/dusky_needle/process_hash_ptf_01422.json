{
    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Dusky Needle loader sample, as reported in campaign PTF-01422. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Dusky Needle Loader: Process started from known malicious binary (PTF-01422)",
        "note": "## Triage and analysis\n\n### Investigating Dusky Needle Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Dusky Needle loader in campaign PTF-01422.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"e26fd879fa7baa33f6140fdcc62fbacff38b25b0eacc992aaf66be50442b36bb\", \"d0e787157159557f355d078f5f7b31a6d4dc5f5c5e36f6cff80a3619a4792314\", \"52799fd270ec289247b4582d512064b56cb9036cf7d678152ecb4be9fc34e44c\", \"3243724df54633c08d53a2230f1d6e7eb70bf9eae02e453e9192b7b6fa54b28e\", \"61862ba920a7a0224b91964fe18c2c159cae41cb0e42038beb0d680115cea9fe\", \"4ac843100afd1e54f93c99e1d9d4127278697b50431be9b129e8f01eab5c6781\", \"bb1444ca6d69618619dcd9f4e6e36a418baf1e8d79e10937fc3a3686ece61475\", \"3d003a42f75b6354a698a27382fc4b809192c943f94a8016b9c0cf81ba412085\")",
        "references": [
