    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Clay Quill loader sample, as reported in campaign PTF-01559. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Clay Quill Loader: Process started from known malicious binary (PTF-01559)",
        "note": "## Triage and analysis\n\n### Investigating Clay Quill Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Clay Quill loader in campaign PTF-01559.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"df6d6e923e290b79f1734a43ce8a4010ca8a2084ed7cb720f8adb75fa993be02\", \"f418139fa8b31c49b95ee0553e99b6fd9980389e714df49fb8a241ddad686dc5\", \"e60e9c7b9a1f6ab0dc70a70efafe854d6a4e8515afd854ffbf9b8f6771ab96b7\", \"8fe46251512de52d3fe4e206c180c3d38289e95ddd08ec26f31c0645149c49d8\", \"a8bac5999815a2aa1199cfe244170486d647001c2722e3e657ee5446d14dc936\", \"b98a919e826129233a9d61a377e418c78e8d156dfc4688c81998fe56944dae54\", \"b29113461f92e3a341a8838557a9582b251559e5403a3af931ae8f98b838164b\", \"7e6e18a4af6daf162a658bb2c03b7d4deb057939d911296804e37e6051e285cb\", \"602007d9660e3855a5a8bbc8c4fd9641247d456f536c8269b30f5a90f2ab45ac\")",
