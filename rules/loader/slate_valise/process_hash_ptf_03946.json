    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Slate Valise loader sample, as reported in campaign PTF-03946. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Slate Valise Loader: Process started from known malicious binary (PTF-03946)",
        "note": "## Triage and analysis\n\n### Investigating Slate Valise Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Slate Valise loader in campaign PTF-03946.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"a69b5297ff2015f7c4da870ccc1c95d2385733a1a9ee8c9cd717705bb8cfcc6b\", \"0ede37e3a0765544076200c0281f07b9a7bd7c9f10ecb8d1b76e69206a533314\", \"6eff2343af55fb3a093b494dd58650042abb33f8304265ac6b84089865d9f5e1\", \"df745af4951a5e0d0eb10d02b9513a647224256ec85ddcb63f9b626a5a158d35\", \"15d5973f00a102b16086007fdcbf113bf1dcb54dd44174c907db5531b4b13242\", \"32adc1b2e4741ed43230011ac7f68f1f0ab016987644883c5c4b7f915bc3ebc8\", \"c1c33900a7fda9ebc4374bfb504f21abbd3dff376dbc5a0405c9377c24152966\", \"02d1018dad35ca63695c2180e033196934494831069f71d7fb9cc5eb630dc91a\")",
