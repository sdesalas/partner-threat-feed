        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Ivory Gimlet loader sample, as reported in campaign PTF-02104. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Ivory Gimlet Loader: Process started from known malicious binary (PTF-02104)",
        "note": "## Triage and analysis\n\n### Investigating Ivory Gimlet Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Ivory Gimlet loader in campaign PTF-02104.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"65a46ec50563dd880e888f2f5083e1ecdbbb08d97e0c6b342a556dd6eb21546a\", \"fcf3b808a8bd362cea128117499f2ceacedc71753f0ab7721c52dfc7b2880bbf\", \"5a345e3fcc70ff65a6c2e0c68b36244295496504b308947f938addbd9ab8cb0e\", \"fd2973ae3af898322aac08fbd54393db861b0c0f5a7c55fd53c9257c7093589e\", \"ea6c97d47e426b5f20667b167058c02460d93f9e30d3c5fb4b0a498d5df481f3\", \"902e7cfa98095f658f3efef16a0514ee6408238730c24bdd2ad0b70937a0c440\", \"a88cb2b64344112c1dd57b187fb5a0590ae5977442ef8682a619d4352785505e\", \"3d0091578062c69f82ba020742800a80d0958b32b85eac57648653a4c0ef5c04\")",
