        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Driftwood Tankard loader sample, as reported in campaign PTF-02414. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Driftwood Tankard Loader: Process started from known malicious binary (PTF-02414)",
        "note": "## Triage and analysis\n\n### Investigating Driftwood Tankard Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Driftwood Tankard loader in campaign PTF-02414.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"968eb48a2336cd931ef382d16e19609f43259c9e3864f5ab22408e3cc8f011ca\", \"b53000a81fd49e63441d417f6b41b3619dd71c15b70b616d5d53b5c51b5a5c38\", \"51dd67fe753285563eb3ac0486dad3e206371988687586dedec2ed792fc1860d\", \"3219967b62b61e10304e802c3a4d9a51926f5f5e4a242f9123f34578c0234a66\", \"44a0f1dd9a088652f98b4535834cf52cb6e66163ed8868c16abaeb9545c95da3\", \"6437abb804dbd0db4f8aed81cffd582af659f222a734f280b8120a7e32bab651\", \"137b4f233ab3d0c61b14996fd5378ec506d46ee0efee29ebc312ae2ddacec765\", \"c9f6ca4bd04987382e9f48212930031f3b987bb5c90f8c11e9f8df977ab9fba2\", \"0f5c541a1dfac7b2f31eeccc5dcee581734892bd496bc6eb9b440a116951a7bb\", \"7b408c96167835dbd16139f2072965d5237917de18400d25d2b1bae585e8236c\")",
