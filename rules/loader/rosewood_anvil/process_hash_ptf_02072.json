{
    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Rosewood Anvil loader sample, as reported in campaign PTF-02072. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Rosewood Anvil Loader: Process started from known malicious binary (PTF-02072)",
        "note": "## Triage and analysis\n\n### Investigating Rosewood Anvil Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Rosewood Anvil loader in campaign PTF-02072.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"0f63a8f4ea0e7f86c0d824f47a76d132f7f5b8484997b9c2994ce2f344177742\", \"cafd097f2130c283a28d5de79b5a5fb45d448bc3a86221ef433a09212f08c803\", \"94f46b146f20a358254d252d22dea05d0a0e48c7738ab8f6c4a82d90000926ce\", \"7ea681fb2f7f1b37208bf3420f954938b83405cdb47e0a589f090776e4cf90b4\", \"78b27350d4c7176e23cb3eb75dd8f94744697add0360f8a7d0a859e1cc836887\", \"e92248ecf1709f1c45863ec951dd1bdf5a4ca88526f881f02a826efb1626768d\", \"8c65710997fc8825b9bb8e3cb2c7161dd9bd4bfacc6ee35614c4097e318244d3\", \"4213984ec8e30b6dd47ad5f4f62c464a0efacd14a104469507fb6c1d73bcce17\", \"8658d7ae97d91f487e407bdc70e0e259ad543c0902c918b84eddd9130bee6458\", \"78a292c78a7e67b588135927d40f8581c279fd1ec8eb655a5a944aeed3e0dcb3\", \"9ee7e84beac696598bdb8d33339ffb7c76593711aad8baaca3f0828742058a9d\")",
