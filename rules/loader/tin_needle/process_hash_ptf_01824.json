        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Tin Needle loader sample, as reported in campaign PTF-01824. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Tin Needle Loader: Process started from known malicious binary (PTF-01824)",
        "note": "## Triage and analysis\n\n### Investigating Tin Needle Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Tin Needle loader in campaign PTF-01824.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"8b53ff73de80459a4bf3f7b9f19f542f510733b86598dc42bb0a528407bbd671\", \"1f5799fae030019d863ede25f7058e7fb00065a550380629bca85fcf9bcadc78\", \"a1351bff0592d33ff39cc91f28fdba3cdf10033a7f7cf656d402f9f91acda6e6\", \"34dabd835b538b6da218a61a45e163102020b0a2781e1e9cdde7e272e5d17434\", \"af4f6cd12b03aa33152fd3bcaedf86f28de094bc65e80def2ba0cab9425e0997\", \"79235d489c232cb0e168168e82863ba065b6452f408646fea913ea6c69d14c24\", \"2c957925c4168ad2d5768622b48f737485c04b3352c95b8cf368208cb5fc2768\", \"6f5159d745a6ed3c978f574990ce3fbfedafb63a4a0cf2024ea95694925a8752\", \"9379fd7fd24d42a5f4b1b596f864b65be5c99841b9898f27bf3450b356cd81dc\")",
