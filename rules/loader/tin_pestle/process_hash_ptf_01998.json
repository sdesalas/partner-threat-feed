        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Tin Pestle loader sample, as reported in campaign PTF-01998. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Tin Pestle Loader: Process started from known malicious binary (PTF-01998)",
        "note": "## Triage and analysis\n\n### Investigating Tin Pestle Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Tin Pestle loader in campaign PTF-01998.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"09643ceb4b72b30183884d9cc23c3752a30d1db8c0c6e2f3a42e810d5139f974\", \"bf9479d4ee778239859d8165b8475a9da97fcc96f102c016cb84c39bcbb5df82\", \"cce4a3ef3e09c486a388fdc2f2f1c14c0f2dd1ed1944ae1d25760217074ad7e1\", \"cb81114e4ad98c4ad5f10627770f5d490e91ca1417ad9b0090ae25f915305646\", \"18f1e878ac1b6a00d31068cb5315d85ef00b6a6421609c35973aa400937aee08\", \"1ca10484b26ad41ac1061641004ec0a953b1c25f6b6cdb8993dc3284ee768684\", \"d01a3130ad4e0347982bada454aad1ca9fe1b97212474800ecd8bdbf84903ae7\", \"a8052647e7e0a62fc5774bbfe4aa168450d1ce2a87ca172fff7eaf436ba2fcfa\", \"bde0e805ae78ecd2b71fc748a47629513ea21d9f5d3664aab4372bd7e14ea223\")",
