        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Tin Pestle loader sample, as reported in campaign PTF-02001. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Tin Pestle Loader: Process started from known malicious binary (PTF-02001)",
        "note": "## Triage and analysis\n\n### Investigating Tin Pestle Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Tin Pestle loader in campaign PTF-02001.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"5b4ea4c4b3eee65c5053d5c38810019cf282472e37d7f02c1cc40b3de03e8fbd\", \"ed91b60e053beaf32a1b5e2a440ae4d62b6360de8de805410bd64c0a182d5f3f\", \"6421243cf28039a06394700a94483878fe9e7deb6b67471ed0a4b33de0d35ea4\", \"2949e0f444c8dbdd56f54bc14edff9bf946f46230e3681193f81da655f173ef6\", \"9ff2574d61a775fc8676705a9b9d7773f4a339163f3420d955e468b7f1454761\", \"67154076d095575247a302495d2d722dd69ca23f1d55903f8bf9cc4780cdab64\", \"da6c880592cc86803a7b113647eacad8a4134838ea0ced751f29f4ba618ff998\", \"9b6746cf2be48814fd7034a1eb1aa859900d5f583b0aa2f9d849de6a2fffefbd\", \"c487dd969e022a46ad881946d8ca729cef3d9fb92c0702e25311610b182ddd37\", \"4d2ea6c6c379febcad341ed2cff80e292071a99a952628a15c7e83195fa83619\")",
