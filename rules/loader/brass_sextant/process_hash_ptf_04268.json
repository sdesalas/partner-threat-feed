    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Brass Sextant loader sample, as reported in campaign PTF-04268. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Brass Sextant Loader: Process started from known malicious binary (PTF-04268)",
        "note": "## Triage and analysis\n\n### Investigating Brass Sextant Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Brass Sextant loader in campaign PTF-04268.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"fb521bfcb05005663c4a144b7588ea6897a108f6d6f8464af8f51633316d719f\", \"0aa99c70cfb9e9d804190492f03334f6902888120c9b39c92ae47a8e519790ea\", \"31bb1139db0e8b3ea41f8a1b4b25dcaf389b850dc1f6911e00f7923aafc71f9e\", \"8f66cce4a039acda4238582efeec49af7e85a4aebaa81eb630de78a06780c314\", \"bb078e99b9ab95e7633552101fb6aa53df4e18fc9828890f2bf6e2a11dcfcf45\", \"cc9efc639b7e092bfa4f69eaac4a7ba1d6335bf1494b711f4fce4f207491df50\", \"626a4852771050b7f7585e458f1ecb494196e36940234ed99c1459e0956a7c49\", \"b2bfcc144c27b663f636f473b9b07663b4ce9bfb28e85f1d927ea9240644341a\")",
        "references": [
