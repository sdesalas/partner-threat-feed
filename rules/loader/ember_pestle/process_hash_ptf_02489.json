        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Ember Pestle loader sample, as reported in campaign PTF-02489. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Ember Pestle Loader: Process started from known malicious binary (PTF-02489)",
        "note": "## Triage and analysis\n\n### Investigating Ember Pestle Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Ember Pestle loader in campaign PTF-02489.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"38714281b8f6fd848e566d0ae4e4aded2d31b8b39ca2acde1aedd09f63d42198\", \"a65ab89d1615306f86a31ba693ee41ed31956f3b4d48cbbdacb7f2ff95acc8e9\", \"09ae0e5c36172675f56c742b19cf453036cfb02889638e0130daf9c37fd92c70\", \"593f8a450d90b61e23f42196434b8c750158a2a2e110446e1466411bbc648493\", \"9549a1ad1383a01ec83183dc82e77025b406e1118a527827262c5abf40d2d29a\", \"96df107c9c6bba6191e234289385f1c73c751014c58b25d85189a59f2683cb33\", \"ffb564973f8678db150aa96bbf70ba3cb4ffd7923516d3ad53dc2cf53ce46a79\", \"47c67fd9f3269d31d4ed770fc03067fa854c1839680622f1b5b424adb1ab742b\", \"e2fb7c02ad2ba5bcd79db83a54ef495596bf2e554ca921ea83901351d1eed095\", \"5f0881e74586a4804a2b15dfdd4cf9926aee8618f70c6c33b7ead4bc2a29efcf\")",
