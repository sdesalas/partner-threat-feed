    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Frosted Bellows loader sample, as reported in campaign PTF-01704. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Frosted Bellows Loader: Process started from known malicious binary (PTF-01704)",
        "note": "## Triage and analysis\n\n### Investigating Frosted Bellows Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Frosted Bellows loader in campaign PTF-01704.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"bb34cc833799f9688b3df173a7586e12b8c740e82780b4d16f86be0ed92208a3\", \"14a941d23f4b8326f7de6a5f4c8fe4bfa9c3b49aa8c02467ac0a3b109909f282\", \"4efa98cfde33464ed118dc2cf730e6dec2b732263690b398d1048701f9012cea\", \"433ef1a1a962fcf3fdf262117d131c5f48593e97262f860f78f7872216d15fc1\", \"60564958acd154cace778946aa12480f80ea5629deb8af07f9230ca89331cde7\", \"e91738a0c179d18fbbe14848df4229e91cf9de0eedb14d9fe95312a9739fae94\", \"5f750dd35ccb1d01d5b9f326b607553c855e5d010c78eb47515e620f6bc4c9b6\", \"42aef16cd1253799c7443765b1b227a2f1047b88465937d965cbb5ab7fa5fd41\")",
