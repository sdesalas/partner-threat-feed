        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Hollow Trellis loader sample, as reported in campaign PTF-03030. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Hollow Trellis Loader: Process started from known malicious binary (PTF-03030)",
        "note": "## Triage and analysis\n\n### Investigating Hollow Trellis Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Hollow Trellis loader in campaign PTF-03030.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"02e351418872a349963e8af4c49235fbcb8a9f3a113bf117727d85eeeff45e8d\", \"90585542c96e6a5a5b9e89a19be080597659df23740c3f0d4a973e04f0bec605\", \"816c5a68ad79990cfde1e72a3e838bc9a51bc1cfd0f3dd79946f7132c03338bb\", \"eaaf0a03782d00bc0a6c836387da4ef94620ddf3045953ebb4568374a87c3bbb\", \"a18504708512a250b80ec00f597710cfa7609a50d25218ce96fa07e1e617bd35\", \"aadfe1221f7bd1ccea1db3e096cc80da106afe3488d69d09e7e6a0e87da71f2c\", \"59a14a5765c772a61be703462b449a693be49b13f60c9a0cc91612a326b87e74\", \"bb0708a3ded5196c4a1a0af4bd23c975fcdb19b840acb3b5d9275c32587a9f37\")",
