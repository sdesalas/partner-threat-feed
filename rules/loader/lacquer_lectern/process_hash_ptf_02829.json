    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Lacquer Lectern loader sample, as reported in campaign PTF-02829. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Lacquer Lectern Loader: Process started from known malicious binary (PTF-02829)",
        "note": "## Triage and analysis\n\n### Investigating Lacquer Lectern Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Lacquer Lectern loader in campaign PTF-02829.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"87ac444e852a0140dc8616f213dc40b06a158537767602f22be8b9f69e0e1356\", \"2f04e90d9d28ebbc33c4542c8b58ff81d351f971223709b6b914ec4b85469763\", \"27d06aece9d94b802034da00179a47fc1e3df383a91afd02e090141cb460f32d\", \"8a7ae5beaccf2b22ec9a5511c8421dd6b57f5d6d358933ff41c1857f4deffdc0\", \"ec16beebd73c53885513ba8168e3af9f2ab2eb8f34ac9cc99dcee6063ac2339d\", \"373bcff297530d28b738788d479987ab9fd5041a79692d4490d9581ecc57a968\", \"2b898c6b128565448890c45c0f255133a281af4b87126aa08a66998ed1d3308e\", \"7f7d225381bdaa2f97dea35273585bb6442f43e15c98475394b77add13fa6032\")",
