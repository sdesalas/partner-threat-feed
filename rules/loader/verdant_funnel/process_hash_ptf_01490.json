{
    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Verdant Funnel loader sample, as reported in campaign PTF-01490. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Verdant Funnel Loader: Process started from known malicious binary (PTF-01490)",
        "note": "## Triage and analysis\n\n### Investigating Verdant Funnel Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Verdant Funnel loader in campaign PTF-01490.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"170b6805c7424f8703ed89d5b8184c748d66a933919542784b32b0d815f44f78\", \"750a0287796c15bf2dc5d64fce3e0dd98622e3c446b43736ed46c2d0f2ce2eb6\", \"fc86002ef9f3431cbdd33d3675eb65323b6f0abe91abbc0e1ec96596931f71d1\", \"d951f68bd4d5612280b89253a983e976010a973ea5625cf61b893b5193656286\", \"a28fdaf3e3b9544bf38485cf14eade614f6534a2fabbc70025b14a78dfc750c1\", \"d81fc748f7f353fe8e2be33dee6a442c3544819d41b07ecdede27fa2c9dad9e1\", \"1e07aec838e5cac80462d23bf26521fc8c88ada095c3d8c08d1b9139c1573f8a\", \"7f44b2954f3c49a910ca1e5b0f3190d6a9483c0294b86cefc867b43cadbb29ef\", \"761239d902d0c8d69276e0d2c9f2306f0739955fe97489cdf4685310fac52752\")",
