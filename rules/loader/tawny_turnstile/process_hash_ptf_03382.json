    "attributes": {
        "author": [
            "Partner Threat Feed"
        ],
        "description": "Identifies processes started from binaries whose SHA-256 hash matches a Tawny Turnstile loader sample, as reported in campaign PTF-03382. The indicators are synthetic and use reserved address and domain ranges, so they match no real traffic.",
        "false_positives": [
            "Security testing that replays known indicators.",
            "A shared hosting address or domain that later served benign content."
        ],
        "from": "now-9m",
        "index": [
            "logs-endpoint.events.process-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Tawny Turnstile Loader: Process started from known malicious binary (PTF-03382)",
        "note": "## Triage and analysis\n\n### Investigating Tawny Turnstile Loader: Process started from known malicious binary\n\nThis rule matches indicators that the Partner Threat Feed attributes to the Tawny Turnstile loader in campaign PTF-03382.\n\n### Possible investigation steps\n\n- Review the matching event and the host or user it came from.\n- Look for other indicators from the same campaign on the same host.\n- Check the process tree around the event for the initial execution or delivery.\n\n### Response and remediation\n\n- Isolate the host if the match is confirmed.\n- Block the indicators at the network edge and on endpoints.\n- Reset credentials used on the host.\n",
        "query": "process where event.type == \"start\" and process.hash.sha256 in (\"154474277bc41397561a4407a5d7583820c0da317c107e2fac00fd0a5b41134b\", \"a319559d9c9fa3c628ae6dd915d723bd07f7ec2bd8717bb78fb2fbe826e306cb\", \"d1266cdc5aeca53796c11959d7275fa08a9c254e3c97d1d45ab2825dd6f16ae0\", \"950733ec3cfeb3e3ea42e29ba23d0979d3974ac79bdd70140abd05d1d7179f5e\", \"1f92dfa22067707b11ac2788293f6eb4f8f46bc144d51dc2c10f23e3d18f0aef\", \"156e644d8c61220ef00998dbbd138acb9a063f5c3c368137ef926561fefaa863\", \"e5b0b0bcfd1ac664ea4f618a1ce45ae4ec34d04473e4bcbc8fbcf2f0870599e3\", \"f72e31820273a1341ae157c849ba4633cc05a898c193f585664298d268d34603\")",
